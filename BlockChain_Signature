/// Safely computes (a mod b) ensuring a positive result.
/// In Rust, the `%` operator is a remainder, not a strict modulo.
pub fn modulo(a: i64, b: i64) -> i64 {
    ((a % b) + b) % b
}

/// Computes the modular multiplicative inverse using the Extended Euclidean Algorithm.
/// Returns x such that (a * x) % m == 1. Returns 0 if no inverse exists.
pub fn mod_inverse(a: i64, m: i64) -> i64 {
    let mut t = 0;
    let mut newt = 1;
    let mut r = m;
    let mut newr = modulo(a, m);

    while newr != 0 {
        let quotient = r / newr;

        let temp_t = t;
        t = newt;
        newt = temp_t - quotient * newt;

        let temp_r = r;
        r = newr;
        newr = temp_r - quotient * newr;
    }

    if r > 1 {
        return 0; // Not invertible
    }
    if t < 0 {
        t += m;
    }
    t
}

/// A simple, std-only Linear Congruential Generator (LCG) for toy randomness.
pub struct ToyRng {
    state: u64,
}

impl ToyRng {
    pub fn new() -> Self {
        let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos() as u64;
        ToyRng { state: now }
    }

    pub fn next_u64(&mut self) -> u64 {
        // POSIX.1-2001 standard LCG parameters
        self.state = self.state.wrapping_mul(6364136223846793005).wrapping_add(1);
        self.state
    }

    /// Returns a random integer in the range [min, max)
    pub fn range(&mut self, min: i64, max: i64) -> i64 {
        if max <= min { return min; }
        min + (self.next_u64() % ((max - min) as u64)) as i64
    }
}

