/// Represents a point on the Elliptic Curve
#[derive(Clone, Copy, Debug, PartialEq)]
pub enum Point {
    Infinity,
    Coord(i64, i64),
}

impl fmt::Display for Point {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        match self {
            Point::Infinity => write!(f, "Point(Infinity)"),
            Point::Coord(x, y) => write!(f, "Point({}, {})", x, y),
        }
    }
}

/// Defines the Elliptic Curve equation: y^2 = x^3 + ax + b (mod p)
#[derive(Clone, Debug)]
pub struct EllipticCurve {
    pub p: i64,      // Prime field
    pub a: i64,      // Curve param a
    pub b: i64,      // Curve param b
    pub g: Point,    // Generator point
    pub n: i64,      // Order of the subgroup generated by G
}

impl EllipticCurve {
    /// Creates a known toy curve. For this implementation, we brute force a valid curve
    /// setup during initialization to guarantee correct mathematics on a small scale.
    /// This mimics secp256k1 (y^2 = x^3 + 7) but mapped to a small prime field.
    pub fn new_toy_curve() -> Self {
        let p = 199;
        let a = 0;
        let b = 7;

        // Find a valid point G
        let mut generator = Point::Infinity;
        for x in 0..p {
            let rhs = modulo(x * x * x + a * x + b, p);
            // Check if rhs is a quadratic residue (Euler's criterion)
            let mut is_qr = false;
            for y in 0..p {
                if modulo(y * y, p) == rhs {
                    generator = Point::Coord(x, y);
                    is_qr = true;
                    break;
                }
            }
            if is_qr { break; }
        }

        let g = generator;

        // Brute force the order of G (n)
        let mut current = g;
        let mut n = 1;
        let temp_curve = EllipticCurve { p, a, b, g: Point::Infinity, n: 0 };

        while current != Point::Infinity {
            current = temp_curve.add(current, g);
            n += 1;
        }

        println!("[*] Initialized Toy Curve: y^2 = x^3 + {} (mod {})", b, p);
        println!("[*] Generator G: {} | Order n: {}", g, n);

        EllipticCurve { p, a, b, g, n }
    }

    /// Adds two points on the elliptic curve P + Q
    pub fn add(&self, p1: Point, p2: Point) -> Point {
        match (p1, p2) {
            (Point::Infinity, p2) => p2,
            (p1, Point::Infinity) => p1,
            (Point::Coord(x1, y1), Point::Coord(x2, y2)) => {
                if x1 == x2 && y1 != y2 {
                    // P + (-P) = Infinity
                    return Point::Infinity;
                }

                let s; // Slope
                if x1 == x2 && y1 == y2 {
                    // Point doubling: P + P
                    if y1 == 0 { return Point::Infinity; }
                    let num = modulo(3 * x1 * x1 + self.a, self.p);
                    let den = mod_inverse(modulo(2 * y1, self.p), self.p);
                    s = modulo(num * den, self.p);
                } else {
                    // Standard addition
                    let num = modulo(y2 - y1, self.p);
                    let den = mod_inverse(modulo(x2 - x1, self.p), self.p);
                    s = modulo(num * den, self.p);
                }

                let x3 = modulo(s * s - x1 - x2, self.p);
                let y3 = modulo(s * (x1 - x3) - y1, self.p);

                Point::Coord(x3, y3)
            }
        }
    }

    /// Scalar multiplication: k * P (using Double-and-Add algorithm)
    /// This is the discrete logarithm function! Easy to compute forward, hard to reverse...
    /// ...unless you have a Quantum Computer running Shor's Algorithm.
    pub fn scalar_mul(&self, k: i64, p: Point) -> Point {
        let mut result = Point::Infinity;
        let mut addend = p;
        let mut scalar = modulo(k, self.n); // Work within the subgroup order

        while scalar > 0 {
            if scalar & 1 == 1 {
                result = self.add(result, addend);
            }
            addend = self.add(addend, addend);
            scalar >>= 1;
        }
        result
    }
}

