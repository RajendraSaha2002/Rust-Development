#[derive(Clone, Debug)]
pub struct Transaction {
    pub sender: String,
    pub receiver: String,
    pub amount: u64,
    pub signature: Option<Signature>,
    pub pub_key_x: i64,
    pub pub_key_y: i64,
}

impl Transaction {
    pub fn new(sender: String, receiver: String, amount: u64, pub_key: Point) -> Self {
        let (x, y) = match pub_key {
            Point::Coord(x, y) => (x, y),
            _ => (0, 0),
        };
        Transaction {
            sender,
            receiver,
            amount,
            signature: None,
            pub_key_x: x,
            pub_key_y: y,
        }
    }

    pub fn calculate_hash(&self) -> [u8; 32] {
        let payload = format!("{}{}{}", self.sender, self.receiver, self.amount);
        Sha256::hash(payload.as_bytes())
    }

    pub fn sign_tx(&mut self, curve: &EllipticCurve, private_key: i64, rng: &mut ToyRng) {
        let tx_hash = self.calculate_hash();
        self.signature = Some(Ecdsa::sign(curve, private_key, &tx_hash, rng));
    }

    pub fn is_valid(&self, curve: &EllipticCurve) -> bool {
        // Mining rewards don't need signatures
        if self.sender == "SYSTEM_MINING_REWARD" {
            return true;
        }

        if let Some(sig) = &self.signature {
            let tx_hash = self.calculate_hash();
            let pub_key = Point::Coord(self.pub_key_x, self.pub_key_y);
            Ecdsa::verify(curve, pub_key, &tx_hash, sig)
        } else {
            false
        }
    }
}

#[derive(Clone, Debug)]
pub struct Block {
    pub index: u64,
    pub timestamp: u64,
    pub transactions: Vec<Transaction>,
    pub previous_hash: String,
    pub nonce: u64,
    pub hash: String,
}

impl Block {
    pub fn new(index: u64, transactions: Vec<Transaction>, previous_hash: String) -> Self {
        let timestamp = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs();
        let mut block = Block {
            index,
            timestamp,
            transactions,
            previous_hash,
            nonce: 0,
            hash: String::new(),
        };
        block.hash = block.calculate_hash();
        block
    }

    pub fn calculate_hash(&self) -> String {
        let mut tx_data = String::new();
        for tx in &self.transactions {
            tx_data.push_str(&tx.sender);
            tx_data.push_str(&tx.receiver);
            tx_data.push_str(&tx.amount.to_string());
        }
        let payload = format!("{}{}{}{}{}", self.index, self.timestamp, tx_data, self.previous_hash, self.nonce);
        let hash_bytes = Sha256::hash(payload.as_bytes());
        Sha256::to_hex(&hash_bytes)
    }

    pub fn mine_block(&mut self, difficulty: usize) {
        let target = "0".repeat(difficulty);
        println!("\n[Mining] Target prefix requirement: '{}'", target);

        while &self.hash[0..difficulty] != target {
            self.nonce += 1;
            self.hash = self.calculate_hash();
        }
        println!("[Mining] Block Mined! Nonce: {} | Hash: {}", self.nonce, self.hash);
    }
}

