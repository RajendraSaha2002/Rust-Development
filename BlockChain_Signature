#[derive(Clone, Debug)]
pub struct KeyPair {
    pub private_key: i64,
    pub public_key: Point,
}

#[derive(Clone, Debug, PartialEq)]
pub struct Signature {
    pub r: i64,
    pub s: i64,
}

pub struct Ecdsa;

impl Ecdsa {
    pub fn generate_keypair(curve: &EllipticCurve, rng: &mut ToyRng) -> KeyPair {
        // Private key d is randomly selected from [1, n-1]
        let private_key = rng.range(1, curve.n);
        // Public key Q = d * G
        let public_key = curve.scalar_mul(private_key, curve.g);

        KeyPair { private_key, public_key }
    }

    /// Truncates a 32-byte SHA256 hash down to our small modular field size for toy calculations.
    /// In a real system, the hash is interpreted as an integer modulo curve order n.
    fn hash_to_int(hash: &[u8; 32], n: i64) -> i64 {
        let prefix = u32::from_be_bytes([hash[0], hash[1], hash[2], hash[3]]);
        modulo(prefix as i64, n)
    }

    pub fn sign(curve: &EllipticCurve, private_key: i64, message_hash: &[u8; 32], rng: &mut ToyRng) -> Signature {
        let z = Self::hash_to_int(message_hash, curve.n);

        loop {
            // 1. Pick a random nonce k in [1, n-1]
            let k = rng.range(1, curve.n);

            // 2. Calculate R = k * G
            let r_point = curve.scalar_mul(k, curve.g);
            let r = match r_point {
                Point::Infinity => continue,
                Point::Coord(x, _) => modulo(x, curve.n),
            };
            if r == 0 { continue; }

            // 3. Calculate s = k^-1 * (z + r * private_key) mod n
            let k_inv = mod_inverse(k, curve.n);
            if k_inv == 0 { continue; }

            let s = modulo(k_inv * (z + r * private_key), curve.n);
            if s == 0 { continue; }

            return Signature { r, s };
        }
    }

    pub fn verify(curve: &EllipticCurve, public_key: Point, message_hash: &[u8; 32], sig: &Signature) -> bool {
        // 1. Verify r and s are in range [1, n-1]
        if sig.r <= 0 || sig.r >= curve.n || sig.s <= 0 || sig.s >= curve.n {
            return false;
        }

        let z = Self::hash_to_int(message_hash, curve.n);

        // 2. Calculate w = s^-1 mod n
        let w = mod_inverse(sig.s, curve.n);
        if w == 0 { return false; }

        // 3. Calculate u1 = z * w mod n  and  u2 = r * w mod n
        let u1 = modulo(z * w, curve.n);
        let u2 = modulo(sig.r * w, curve.n);

        // 4. Calculate point P = u1 * G + u2 * Q
        let p1 = curve.scalar_mul(u1, curve.g);
        let p2 = curve.scalar_mul(u2, public_key);
        let p = curve.add(p1, p2);

        // 5. Verification succeeds if P.x == r
        match p {
            Point::Infinity => false,
            Point::Coord(x, _) => modulo(x, curve.n) == sig.r,
        }
    }
}

