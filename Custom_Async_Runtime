// 10. MANUAL COMPILER DESUGARING DEMONSTRATION
// ============================================================================

/// Hand-written state machine matching compiler lowering of:
/// ```text
/// async fn compute(id: u32) -> u64 {
///     let step1 = (id as u64) * 10;
///     sleep(50ms).await;
///     let step2 = step1 + 42;
///     sleep(50ms).await;
///     step2 * 2
/// }
/// ```
pub enum DesugaredStateMachineFuture {
    Start { id: u32 },
    AwaitingSleep1 { step1: u64, sleep_fut: SleepFuture },
    AwaitingSleep2 { step2: u64, sleep_fut: SleepFuture },
    Done,
}

impl DesugaredStateMachineFuture {
    pub fn new(id: u32) -> Self {
        DesugaredStateMachineFuture::Start { id }
    }
}

impl Future for DesugaredStateMachineFuture {
    type Output = u64;

    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
        let this = self.get_mut();
        loop {
            match std::mem::replace(this, DesugaredStateMachineFuture::Done) {
                DesugaredStateMachineFuture::Start { id } => {
                    println!("  [DESUGAR STATE MACHINE] State: Start -> calculating step1");
                    let step1 = (id as u64) * 10;
                    let sleep_fut = sleep(Duration::from_millis(50));
                    *this = DesugaredStateMachineFuture::AwaitingSleep1 { step1, sleep_fut };
                }

                DesugaredStateMachineFuture::AwaitingSleep1 {
                    step1,
                    mut sleep_fut,
                } => {
                    println!("  [DESUGAR STATE MACHINE] Polling Child Future: Sleep #1");
                    match Pin::new(&mut sleep_fut).poll(cx) {
                        Poll::Pending => {
                            *this = DesugaredStateMachineFuture::AwaitingSleep1 { step1, sleep_fut };
                            return Poll::Pending;
                        }
                        Poll::Ready(()) => {
                            println!("  [DESUGAR STATE MACHINE] Child Sleep #1 Ready -> Transition to State 2");
                            let step2 = step1 + 42;
                            let next_sleep = sleep(Duration::from_millis(50));
                            *this = DesugaredStateMachineFuture::AwaitingSleep2 {
                                step2,
                                sleep_fut: next_sleep,
                            };
                        }
                    }
                }

                DesugaredStateMachineFuture::AwaitingSleep2 {
                    step2,
                    mut sleep_fut,
                } => {
                    println!("  [DESUGAR STATE MACHINE] Polling Child Future: Sleep #2");
                    match Pin::new(&mut sleep_fut).poll(cx) {
                        Poll::Pending => {
                            *this = DesugaredStateMachineFuture::AwaitingSleep2 { step2, sleep_fut };
                            return Poll::Pending;
                        }
                        Poll::Ready(()) => {
                            println!("  [DESUGAR STATE MACHINE] Child Sleep #2 Ready -> Computing final result");
                            *this = DesugaredStateMachineFuture::Done;
                            return Poll::Ready(step2 * 2);
                        }
                    }
                }

                DesugaredStateMachineFuture::Done => {
                    panic!("Polled future after completion!");
                }
            }
        }
    }
}

