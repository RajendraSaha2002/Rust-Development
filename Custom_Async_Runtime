pub fn yield_now() -> YieldFuture {
    YieldFuture { yielded: false }
}

pub struct YieldFuture {
    yielded: bool,
}

impl Future for YieldFuture {
    type Output = ();

    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
        let this = self.get_mut();
        if this.yielded {
            Poll::Ready(())
        } else {
            this.yielded = true;
            cx.waker().wake_by_ref();
            Poll::Pending
        }
    }
}

struct JoinFuture<A: Future, B: Future> {
    a: Pin<Box<A>>,
    b: Pin<Box<B>>,
    a_res: Option<A::Output>,
    b_res: Option<B::Output>,
}

impl<A: Future, B: Future> Unpin for JoinFuture<A, B> {}

impl<A: Future, B: Future> Future for JoinFuture<A, B> {
    type Output = (A::Output, B::Output);

    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
        let this = self.get_mut();

        if this.a_res.is_none() {
            if let Poll::Ready(val) = this.a.as_mut().poll(cx) {
                this.a_res = Some(val);
            }
        }
        if this.b_res.is_none() {
            if let Poll::Ready(val) = this.b.as_mut().poll(cx) {
                this.b_res = Some(val);
            }
        }

        if this.a_res.is_some() && this.b_res.is_some() {
            let a_val = this.a_res.take().unwrap();
            let b_val = this.b_res.take().unwrap();
            Poll::Ready((a_val, b_val))
        } else {
            Poll::Pending
        }
    }
}

/// Awaits two futures concurrently, resolving when both complete.
pub async fn join2<F1, F2>(f1: F1, f2: F2) -> (F1::Output, F2::Output)
where
    F1: Future,
    F2: Future,
{
    JoinFuture {
        a: Box::pin(f1),
        b: Box::pin(f2),
        a_res: None,
        b_res: None,
    }
        .await
}

#[derive(Debug)]
pub enum Either<A, B> {
    Left(A),
    Right(B),
}

struct RaceFuture<A: Future, B: Future> {
    a: Pin<Box<A>>,
    b: Pin<Box<B>>,
}

impl<A: Future, B: Future> Unpin for RaceFuture<A, B> {}

impl<A: Future, B: Future> Future for RaceFuture<A, B> {
    type Output = Either<A::Output, B::Output>;

    fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
        let this = self.get_mut();
        if let Poll::Ready(v) = this.a.as_mut().poll(cx) {
            return Poll::Ready(Either::Left(v));
        }
        if let Poll::Ready(v) = this.b.as_mut().poll(cx) {
            return Poll::Ready(Either::Right(v));
        }
        Poll::Pending
    }
}

/// Awaits two futures concurrently, returning the output of the first one to resolve.
pub async fn race2<F1, F2>(f1: F1, f2: F2) -> Either<F1::Output, F2::Output>
where
    F1: Future,
    F2: Future,
{
    RaceFuture {
        a: Box::pin(f1),
        b: Box::pin(f2),
    }
        .await
}

