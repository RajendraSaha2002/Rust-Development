        println!(">>> DEMO 2: Spawning Concurrent Timers on Multithreaded Executor");
        let t1 = spawn(async {
            println!("  [Task 1] started on thread: {:?}", thread::current().name());
            sleep(Duration::from_millis(150)).await;
            println!("  [Task 1] woke up after 150ms!");
            1001
        });

        let t2 = spawn(async {
            println!("  [Task 2] started on thread: {:?}", thread::current().name());
            sleep(Duration::from_millis(50)).await;
            println!("  [Task 2] woke up after 50ms!");
            2002
        });

        let t3 = spawn(async {
            println!("  [Task 3] started on thread: {:?}", thread::current().name());
            sleep(Duration::from_millis(100)).await;
            println!("  [Task 3] woke up after 100ms!");
            3003
        });

        let (r1, r2, r3) = (t1.await, t2.await, t3.await);
        println!(">>> All timed tasks joined with outputs: {}, {}, {}\n", r1, r2, r3);

        // DEMO 3: Async Channel (Producer-Consumer)
        println!(">>> DEMO 3: Async MPSC Channel (Producer-Consumer Tasks)");
        let (tx, mut rx) = channel::<String>();

        let producer = spawn(async move {
            for i in 1..=4 {
                sleep(Duration::from_millis(30)).await;
                let msg = format!("Message #{}", i);
                println!("  [Producer] Sent: {}", msg);
                tx.send(msg).unwrap();
            }
            println!("  [Producer] Finished sending. Sender dropped.");
        });

        let consumer = spawn(async move {
            let mut count = 0;
            while let Some(msg) = rx.recv().await {
                println!("  [Consumer] Received: {}", msg);
                count += 1;
            }
            println!("  [Consumer] Channel closed. Total messages processed: {}", count);
            count
        });

        let (_, count) = join2(producer, consumer).await;
        println!(">>> Producer and Consumer completed successfully. Item count = {}\n", count);

        // DEMO 4: Combinators (Race)
        println!(">>> DEMO 4: Combinators (race2 and join2)");
        let fast_task = async {
            sleep(Duration::from_millis(20)).await;
            "Fast Winner"
        };
        let slow_task = async {
            sleep(Duration::from_millis(120)).await;
            "Slow Loser"
        };

        match race2(fast_task, slow_task).await {
            Either::Left(winner) => println!("  race2 winner: {}", winner),
            Either::Right(winner) => println!("  race2 winner: {}", winner),
        }

        // DEMO 5: Non-blocking Async TCP Echo Server & Client
        println!("\n>>> DEMO 5: Real Non-blocking Async TCP Network I/O");
        let server_addr = "127.0.0.1:9095";
        let listener = AsyncTcpListener::bind(server_addr).expect("Failed to bind TCP listener");

        let server_task = spawn(async move {
            println!("  [Server] Listening on {}", server_addr);
            let (mut stream, addr) = listener.accept().await.expect("Accept failed");
            println!("  [Server] Connection accepted from: {}", addr);

            let mut buf = [0u8; 128];
            let n = stream.read(&mut buf).await.expect("Read failed");
            println!(
                "  [Server] Read {} bytes: \"{}\"",
                n,
                String::from_utf8_lossy(&buf[..n])
            );

            stream.write(&buf[..n]).await.expect("Write failed");
            println!("  [Server] Echoed back payload successfully.");
        });

        let client_task = spawn(async move {
            sleep(Duration::from_millis(40)).await;
            println!("  [Client] Connecting to {}", server_addr);
            let mut stream = AsyncTcpStream::connect(server_addr)
                .await
                .expect("Client connect failed");

            let payload = b"Hello from pure std Async Runtime!";
            stream.write(payload).await.expect("Client write failed");
            println!("  [Client] Sent payload: \"{}\"", String::from_utf8_lossy(payload));

            let mut buf = [0u8; 128];
            let n = stream.read(&mut buf).await.expect("Client read failed");
            println!(
                "  [Client] Received echo: \"{}\"",
                String::from_utf8_lossy(&buf[..n])
            );
            assert_eq!(&buf[..n], payload);
        });

        join2(server_task, client_task).await;
        println!("\n>>> Async TCP test completed with verified packet parity!");
    });

    println!("\n=================================================================");
    println!("     ALL ASYNC RUNTIME TESTS PASSED SUCCESSFULLY!                ");
    println!("=================================================================");
}
