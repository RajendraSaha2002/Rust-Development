    /// Arbitrary-precision unsigned integer represented by 64-bit limbs (little-endian).
    #[derive(Clone, PartialEq, Eq)]
    pub struct BigUint {
        pub limbs: Vec<u64>,
    }

    impl BigUint {
        pub fn zero() -> Self {
            BigUint { limbs: vec![0] }
        }

        pub fn from_u64(val: u64) -> Self {
            BigUint { limbs: vec![val] }
        }

        pub fn from_be_bytes(bytes: &[u8]) -> Self {
            if bytes.is_empty() {
                return Self::zero();
            }
            let mut limbs = Vec::new();
            for chunk in bytes.rchunks(8) {
                let mut limb = 0u64;
                for (i, &b) in chunk.iter().enumerate() {
                    let shift = (chunk.len() - 1 - i) * 8;
                    limb |= (b as u64) << shift;
                }
                limbs.push(limb);
            }
            let mut b = BigUint { limbs };
            b.normalize();
            b
        }

        pub fn to_be_bytes(&self) -> Vec<u8> {
            if self.is_zero() {
                return vec![0];
            }
            let mut bytes = Vec::with_capacity(self.limbs.len() * 8);
            for &limb in self.limbs.iter().rev() {
                bytes.extend_from_slice(&limb.to_be_bytes());
            }
            // Strip leading zero bytes
            let first_non_zero = bytes.iter().position(|&b| b != 0).unwrap_or(bytes.len() - 1);
            bytes[first_non_zero..].to_vec()
        }

        pub fn from_hex(hex: &str) -> Result<Self, String> {
            let clean: String = hex.chars().filter(|c| !c.is_whitespace() && *c != '_').collect();
            if clean.is_empty() {
                return Ok(Self::zero());
            }
            let padded = if clean.len() % 2 != 0 {
                format!("0{}", clean)
            } else {
                clean
            };

            let mut bytes = Vec::with_capacity(padded.len() / 2);
            for i in (0..padded.len()).step_by(2) {
                let byte = u8::from_str_radix(&padded[i..i + 2], 16)
                    .map_err(|e| format!("Invalid hex: {}", e))?;
                bytes.push(byte);
            }
            Ok(Self::from_be_bytes(&bytes))
        }

        pub fn is_zero(&self) -> bool {
            self.limbs.is_empty() || (self.limbs.len() == 1 && self.limbs[0] == 0)
        }

        pub fn is_odd(&self) -> bool {
            !self.limbs.is_empty() && (self.limbs[0] & 1) != 0
        }

        pub fn bit_length(&self) -> usize {
            if self.is_zero() {
                return 0;
            }
            let last_idx = self.limbs.len() - 1;
            let highest_limb = self.limbs[last_idx];
            let leading_zeros = highest_limb.leading_zeros() as usize;
            (self.limbs.len() * 64) - leading_zeros
        }

        pub fn bit_at(&self, index: usize) -> bool {
            let limb_idx = index / 64;
            let bit_idx = index % 64;
            if limb_idx >= self.limbs.len() {
                return false;
            }
            (self.limbs[limb_idx] & (1 << bit_idx)) != 0
        }

        fn normalize(&mut self) {
            while self.limbs.len() > 1 && self.limbs.last() == Some(&0) {
                self.limbs.pop();
            }
        }

        pub fn cmp_ref(&self, other: &BigUint) -> Ordering {
            if self.limbs.len() != other.limbs.len() {
                return self.limbs.len().cmp(&other.limbs.len());
            }
            for (a, b) in self.limbs.iter().rev().zip(other.limbs.iter().rev()) {
                if a != b {
                    return a.cmp(b);
                }
            }
            Ordering::Equal
        }

        pub fn add(&self, other: &BigUint) -> BigUint {
            let max_len = std::cmp::max(self.limbs.len(), other.limbs.len());
            let mut result = Vec::with_capacity(max_len + 1);
            let mut carry = 0u128;

            for i in 0..max_len {
                let a = if i < self.limbs.len() { self.limbs[i] as u128 } else { 0 };
                let b = if i < other.limbs.len() { other.limbs[i] as u128 } else { 0 };
                let sum = a + b + carry;
                result.push(sum as u64);
                carry = sum >> 64;
            }

            if carry > 0 {
                result.push(carry as u64);
            }

            let mut res = BigUint { limbs: result };
            res.normalize();
            res
        }

        pub fn sub(&self, other: &BigUint) -> BigUint {
            assert!(self.cmp_ref(other) != Ordering::Less, "Subtraction underflow");
            let mut result = Vec::with_capacity(self.limbs.len());
            let mut borrow = 0i128;

            for i in 0..self.limbs.len() {
                let a = self.limbs[i] as i128;
                let b = if i < other.limbs.len() { other.limbs[i] as i128 } else { 0 };
                let diff = a - b - borrow;
                if diff < 0 {
                    result.push((diff + (1i128 << 64)) as u64);
                    borrow = 1;
                } else {
                    result.push(diff as u64);
                    borrow = 0;
                }
            }

            let mut res = BigUint { limbs: result };
            res.normalize();
            res
        }

        pub fn mul(&self, other: &BigUint) -> BigUint {
            if self.is_zero() || other.is_zero() {
                return BigUint::zero();
            }
            let mut result = vec![0u64; self.limbs.len() + other.limbs.len()];

            for i in 0..self.limbs.len() {
                let mut carry = 0u128;
                for j in 0..other.limbs.len() {
                    let cur = result[i + j] as u128
                        + (self.limbs[i] as u128) * (other.limbs[j] as u128)
                        + carry;
                    result[i + j] = cur as u64;
                    carry = cur >> 64;
                }
                result[i + other.limbs.len()] += carry as u64;
            }

            let mut res = BigUint { limbs: result };
            res.normalize();
            res
        }

        pub fn shl1(&self) -> BigUint {
            let mut res = Vec::with_capacity(self.limbs.len() + 1);
            let mut carry = 0u64;
            for &limb in &self.limbs {
                res.push((limb << 1) | carry);
                carry = limb >> 63;
            }
            if carry != 0 {
                res.push(carry);
            }
            let mut b = BigUint { limbs: res };
            b.normalize();
            b
        }

        pub fn shr1(&self) -> BigUint {
            let mut res = vec![0u64; self.limbs.len()];
            let mut carry = 0u64;
            for i in (0..self.limbs.len()).rev() {
                let limb = self.limbs[i];
                res[i] = (limb >> 1) | carry;
                carry = limb << 63;
            }
            let mut b = BigUint { limbs: res };
            b.normalize();
            b
        }

        /// Binary restoring long division: computes (quotient, remainder).
        pub fn div_rem(&self, divisor: &BigUint) -> (BigUint, BigUint) {
            assert!(!divisor.is_zero(), "Division by zero");
            if self.cmp_ref(divisor) == Ordering::Less {
                return (BigUint::zero(), self.clone());
            }

            let mut remainder = BigUint::zero();
            let total_bits = self.bit_length();
            let mut quotient_limbs = vec![0u64; (total_bits + 63) / 64];

            for i in (0..total_bits).rev() {
                remainder = remainder.shl1();
                if self.bit_at(i) {
                    remainder.limbs[0] |= 1;
                }
                remainder.normalize();

                if remainder.cmp_ref(divisor) != Ordering::Less {
                    remainder = remainder.sub(divisor);
                    let q_limb = i / 64;
                    let q_bit = i % 64;
                    quotient_limbs[q_limb] |= 1 << q_bit;
                }
            }

            let mut quotient = BigUint { limbs: quotient_limbs };
            quotient.normalize();
            (quotient, remainder)
        }

        /// Square-and-multiply modular exponentiation: self^exponent mod modulus.
        pub fn mod_pow(&self, exponent: &BigUint, modulus: &BigUint) -> BigUint {
            assert!(!modulus.is_zero(), "Modulus cannot be zero");
            if modulus.limbs == [1] {
                return BigUint::zero();
            }

            let mut result = BigUint::from_u64(1);
            let (_, mut base) = self.div_rem(modulus);
            let mut exp = exponent.clone();

            while !exp.is_zero() {
                if exp.is_odd() {
                    let prod = result.mul(&base);
                    let (_, rem) = prod.div_rem(modulus);
                    result = rem;
                }
                let sq = base.mul(&base);
                let (_, rem) = sq.div_rem(modulus);
                base = rem;
                exp = exp.shr1();
            }
            result
        }
    }

    impl fmt::Debug for BigUint {
        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
            let bytes = self.to_be_bytes();
            write!(f, "0x")?;
            for b in bytes {
                write!(f, "{:02x}", b)?;
            }
            Ok(())
        }
    }
}

