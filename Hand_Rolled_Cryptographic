pub struct HandshakeEngine;

impl HandshakeEngine {
    /// Executes the Server side of the Mini-TLS Handshake over raw TCP.
    pub fn accept_handshake(mut stream: TcpStream) -> Result<SecureSession<TcpStream>, String> {
        let mut transcript = protocol::Transcript::new();

        // 1. Receive ClientHello
        let client_hello_frame = protocol::RecordFrame::deserialize(&mut stream)?;
        transcript.update(&client_hello_frame.payload);

        let ch = &client_hello_frame.payload;
        if ch[0] != protocol::HandshakeType::ClientHello as u8 {
            return Err("Expected ClientHello".to_string());
        }
        let client_random = ch[1..33].to_vec();
        let client_pub_len = u16::from_be_bytes([ch[33], ch[34]]) as usize;
        let client_pub_bytes = &ch[35..35 + client_pub_len];
        let client_pub = BigUint::from_be_bytes(client_pub_bytes);

        // 2. Generate Server Ephemeral DH Keypair & Random
        let server_random = entropy::random_bytes(32);
        let dh_prime = BigUint::from_hex(DH_PRIME_512)?;
        let dh_gen = BigUint::from_u64(DH_GENERATOR);
        let server_priv = entropy::random_biguint(128);
        let server_pub = dh_gen.mod_pow(&server_priv, &dh_prime);

        // 3. Send ServerHello
        let mut server_hello_payload = Vec::new();
        server_hello_payload.push(protocol::HandshakeType::ServerHello as u8);
        server_hello_payload.extend_from_slice(&server_random);

        let sh_frame = protocol::RecordFrame {
            content_type: protocol::ContentType::Handshake,
            version: protocol::PROTOCOL_VERSION,
            sequence_number: 0,
            payload: server_hello_payload,
        };
        transcript.update(&sh_frame.payload);
        stream.write_all(&sh_frame.serialize()).map_err(|e| e.to_string())?;

        // 4. Send ServerKeyExchange
        let server_pub_bytes = server_pub.to_be_bytes();
        let mut ske_payload = Vec::new();
        ske_payload.push(protocol::HandshakeType::ServerKeyExchange as u8);
        ske_payload.extend_from_slice(&(server_pub_bytes.len() as u16).to_be_bytes());
        ske_payload.extend_from_slice(&server_pub_bytes);

        let ske_frame = protocol::RecordFrame {
            content_type: protocol::ContentType::Handshake,
            version: protocol::PROTOCOL_VERSION,
            sequence_number: 1,
            payload: ske_payload,
        };
        transcript.update(&ske_frame.payload);
        stream.write_all(&ske_frame.serialize()).map_err(|e| e.to_string())?;

        // 5. Derive Session Keys: Shared Secret = (ClientPub)^ServerPriv mod P
        let shared_secret = client_pub.mod_pow(&server_priv, &dh_prime);
        let keys = protocol::SessionKeys::derive(&shared_secret, &client_random, &server_random);

        // 6. Receive Client Finished (Encrypted)
        let mut session = SecureSession::new_server(stream, keys);
        let (ct, client_finished_payload) = session.recv_encrypted()?;
        if ct != protocol::ContentType::Handshake || client_finished_payload[0] != protocol::HandshakeType::Finished as u8 {
            return Err("Expected Client Finished".to_string());
        }

        let expected_client_verify = hmac::HmacSha256::mac(&session.read_mac_key, &transcript.current_hash());
        if !constant_time_eq(&client_finished_payload[1..33], &expected_client_verify) {
            return Err("Client Finished verification failed! Man-in-the-Middle detected.".to_string());
        }
        transcript.update(&client_finished_payload);

        // 7. Send Server Finished (Encrypted)
        let server_verify = hmac::HmacSha256::mac(&session.write_mac_key, &transcript.current_hash());
        let mut server_finished_payload = Vec::new();
        server_finished_payload.push(protocol::HandshakeType::Finished as u8);
        server_finished_payload.extend_from_slice(&server_verify);

        session.send_encrypted(protocol::ContentType::Handshake, &server_finished_payload)?;

        Ok(session)
    }

    /// Executes the Client side of the Mini-TLS Handshake over raw TCP.
    pub fn connect_handshake(mut stream: TcpStream) -> Result<SecureSession<TcpStream>, String> {
        let mut transcript = protocol::Transcript::new();

        // 1. Generate Client Ephemeral DH Keypair & Random
        let client_random = entropy::random_bytes(32);
        let dh_prime = BigUint::from_hex(DH_PRIME_512)?;
        let dh_gen = BigUint::from_u64(DH_GENERATOR);
        let client_priv = entropy::random_biguint(128);
        let client_pub = dh_gen.mod_pow(&client_priv, &dh_prime);
        let client_pub_bytes = client_pub.to_be_bytes();

        // 2. Send ClientHello
        let mut ch_payload = Vec::new();
        ch_payload.push(protocol::HandshakeType::ClientHello as u8);
        ch_payload.extend_from_slice(&client_random);
        ch_payload.extend_from_slice(&(client_pub_bytes.len() as u16).to_be_bytes());
        ch_payload.extend_from_slice(&client_pub_bytes);

        let ch_frame = protocol::RecordFrame {
            content_type: protocol::ContentType::Handshake,
            version: protocol::PROTOCOL_VERSION,
            sequence_number: 0,
            payload: ch_payload,
        };
        transcript.update(&ch_frame.payload);
        stream.write_all(&ch_frame.serialize()).map_err(|e| e.to_string())?;

        // 3. Receive ServerHello
        let sh_frame = protocol::RecordFrame::deserialize(&mut stream)?;
        transcript.update(&sh_frame.payload);
        let sh = &sh_frame.payload;
        if sh[0] != protocol::HandshakeType::ServerHello as u8 {
            return Err("Expected ServerHello".to_string());
        }
        let server_random = sh[1..33].to_vec();

        // 4. Receive ServerKeyExchange
        let ske_frame = protocol::RecordFrame::deserialize(&mut stream)?;
        transcript.update(&ske_frame.payload);
        let ske = &ske_frame.payload;
        if ske[0] != protocol::HandshakeType::ServerKeyExchange as u8 {
            return Err("Expected ServerKeyExchange".to_string());
        }
        let server_pub_len = u16::from_be_bytes([ske[1], ske[2]]) as usize;
        let server_pub_bytes = &ske[3..3 + server_pub_len];
        let server_pub = BigUint::from_be_bytes(server_pub_bytes);

        // 5. Derive Shared Secret = (ServerPub)^ClientPriv mod P
        let shared_secret = server_pub.mod_pow(&client_priv, &dh_prime);
        let keys = protocol::SessionKeys::derive(&shared_secret, &client_random, &server_random);

        let mut session = SecureSession::new_client(stream, keys);

        // 6. Send Client Finished (Encrypted)
        let client_verify = hmac::HmacSha256::mac(&session.write_mac_key, &transcript.current_hash());
        let mut client_finished_payload = Vec::new();
        client_finished_payload.push(protocol::HandshakeType::Finished as u8);
        client_finished_payload.extend_from_slice(&client_verify);

        session.send_encrypted(protocol::ContentType::Handshake, &client_finished_payload)?;
        transcript.update(&client_finished_payload);

        // 7. Receive Server Finished (Encrypted)
        let (ct, server_finished_payload) = session.recv_encrypted()?;
        if ct != protocol::ContentType::Handshake || server_finished_payload[0] != protocol::HandshakeType::Finished as u8 {
            return Err("Expected Server Finished".to_string());
        }

        let expected_server_verify = hmac::HmacSha256::mac(&session.read_mac_key, &transcript.current_hash());
        if !constant_time_eq(&server_finished_payload[1..33], &expected_server_verify) {
            return Err("Server Finished verification failed! Handshake downgraded or forged.".to_string());
        }

        Ok(session)
    }
}

