        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];

    #[derive(Clone)]
    pub struct Sha256 {
        state: [u32; 8],
        buffer: [u8; BLOCK_SIZE],
        buf_len: usize,
        total_len: u64,
    }

    impl Sha256 {
        pub fn new() -> Self {
            Sha256 {
                state: [
                    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                    0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
                ],
                buffer: [0u8; BLOCK_SIZE],
                buf_len: 0,
                total_len: 0,
            }
        }

        pub fn update(&mut self, mut data: &[u8]) {
            self.total_len += data.len() as u64;

            while !data.is_empty() {
                let fill = std::cmp::min(data.len(), BLOCK_SIZE - self.buf_len);
                self.buffer[self.buf_len..self.buf_len + fill].copy_from_slice(&data[..fill]);
                self.buf_len += fill;
                data = &data[fill..];

                if self.buf_len == BLOCK_SIZE {
                    let block = self.buffer;
                    self.compress(&block);
                    self.buf_len = 0;
                }
            }
        }

        pub fn finalize(mut self) -> [u8; DIGEST_SIZE] {
            // Append 0x80 byte
            self.buffer[self.buf_len] = 0x80;
            self.buf_len += 1;

            if self.buf_len > 56 {
                for i in self.buf_len..BLOCK_SIZE {
                    self.buffer[i] = 0;
                }
                let block = self.buffer;
                self.compress(&block);
                self.buf_len = 0;
            }

            for i in self.buf_len..56 {
                self.buffer[i] = 0;
            }

            let bit_len = self.total_len * 8;
            self.buffer[56..64].copy_from_slice(&bit_len.to_be_bytes());
            let block = self.buffer;
            self.compress(&block);

            let mut out = [0u8; DIGEST_SIZE];
            for (i, &val) in self.state.iter().enumerate() {
                out[i * 4..(i + 1) * 4].copy_from_slice(&val.to_be_bytes());
            }
            out
        }

        pub fn digest(data: &[u8]) -> [u8; DIGEST_SIZE] {
            let mut hasher = Self::new();
            hasher.update(data);
            hasher.finalize()
        }

        fn compress(&mut self, block: &[u8; BLOCK_SIZE]) {
            let mut w = [0u32; 64];
            for i in 0..16 {
                w[i] = u32::from_be_bytes([
                    block[i * 4],
                    block[i * 4 + 1],
                    block[i * 4 + 2],
                    block[i * 4 + 3],
                ]);
            }

            for i in 16..64 {
                let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
                let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
                w[i] = w[i - 16].wrapping_add(s0).wrapping_add(w[i - 7]).wrapping_add(s1);
            }

            let mut a = self.state[0];
            let mut b = self.state[1];
            let mut c = self.state[2];
            let mut d = self.state[3];
            let mut e = self.state[4];
            let mut f = self.state[5];
            let mut g = self.state[6];
            let mut h = self.state[7];

            for i in 0..64 {
                let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
                let ch = (e & f) ^ ((!e) & g);
                let temp1 = h
                    .wrapping_add(s1)
                    .wrapping_add(ch)
                    .wrapping_add(K[i])
                    .wrapping_add(w[i]);
                let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
                let maj = (a & b) ^ (a & c) ^ (b & c);
                let temp2 = s0.wrapping_add(maj);

                h = g;
                g = f;
                f = e;
                e = d.wrapping_add(temp1);
                d = c;
                c = b;
                b = a;
                a = temp1.wrapping_add(temp2);
            }

            self.state[0] = self.state[0].wrapping_add(a);
            self.state[1] = self.state[1].wrapping_add(b);
            self.state[2] = self.state[2].wrapping_add(c);
            self.state[3] = self.state[3].wrapping_add(d);
            self.state[4] = self.state[4].wrapping_add(e);
            self.state[5] = self.state[5].wrapping_add(f);
            self.state[6] = self.state[6].wrapping_add(g);
            self.state[7] = self.state[7].wrapping_add(h);
        }
    }
}

// ============================================================================
// MODULE 3: KEYED-HASH MAC (RFC 2104 HMAC-SHA256) & PRF
// ============================================================================

pub mod hmac {
    use super::sha256::{Sha256, BLOCK_SIZE, DIGEST_SIZE};
    pub use super::constant_time_eq;

    pub struct HmacSha256 {
        inner_hasher: Sha256,
        opad_key: [u8; BLOCK_SIZE],
    }

    impl HmacSha256 {
        pub fn new(key: &[u8]) -> Self {
            let mut formatted_key = [0u8; BLOCK_SIZE];
            if key.len() > BLOCK_SIZE {
                let digest = Sha256::digest(key);
                formatted_key[..DIGEST_SIZE].copy_from_slice(&digest);
            } else {
                formatted_key[..key.len()].copy_from_slice(key);
            }

            let mut ipad = [0u8; BLOCK_SIZE];
            let mut opad = [0u8; BLOCK_SIZE];

            for i in 0..BLOCK_SIZE {
                ipad[i] = formatted_key[i] ^ 0x36;
                opad[i] = formatted_key[i] ^ 0x5c;
            }

            let mut inner_hasher = Sha256::new();
            inner_hasher.update(&ipad);

            HmacSha256 {
                inner_hasher,
                opad_key: opad,
            }
        }

        pub fn update(&mut self, data: &[u8]) {
            self.inner_hasher.update(data);
        }

        pub fn finalize(self) -> [u8; DIGEST_SIZE] {
            let inner_hash = self.inner_hasher.finalize();
            let mut outer_hasher = Sha256::new();
            outer_hasher.update(&self.opad_key);
            outer_hasher.update(&inner_hash);
            outer_hasher.finalize()
        }

        pub fn mac(key: &[u8], data: &[u8]) -> [u8; DIGEST_SIZE] {
            let mut hmac = Self::new(key);
            hmac.update(data);
            hmac.finalize()
        }

        /// Verifies a MAC tag in constant time.
        pub fn verify(key: &[u8], data: &[u8], expected_tag: &[u8]) -> bool {
            let actual_tag = Self::mac(key, data);
            constant_time_eq(&actual_tag, expected_tag)
        }
    }

    /// TLS PRF / HKDF Expand implementation for deriving session keys.
    pub fn hkdf_expand(prk: &[u8], info: &[u8], length: usize) -> Vec<u8> {
        let mut okm = Vec::with_capacity(length);
        let mut previous_t: Vec<u8> = Vec::new();
        let mut counter = 1u8;

        while okm.len() < length {
            let mut hmac = HmacSha256::new(prk);
            if !previous_t.is_empty() {
                hmac.update(&previous_t);
            }
            hmac.update(info);
            hmac.update(&[counter]);
            let t = hmac.finalize();
            previous_t = t.to_vec();

            let to_take = std::cmp::min(length - okm.len(), DIGEST_SIZE);
            okm.extend_from_slice(&t[..to_take]);
            counter += 1;
        }

        okm
    }
}

