            let b0 = SBOX[(w >> 24) as usize] as u32;
            let b1 = SBOX[((w >> 16) & 0xff) as usize] as u32;
            let b2 = SBOX[((w >> 8) & 0xff) as usize] as u32;
            let b3 = SBOX[(w & 0xff) as usize] as u32;
            (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        }

        fn rot_word(w: u32) -> u32 {
            w.rotate_left(8)
        }

        fn key_expansion(key: &[u8; KEY_SIZE], round_keys: &mut [u8; ROUND_KEYS_SIZE]) {
            let mut w = [0u32; 44];
            for i in 0..4 {
                w[i] = u32::from_be_bytes([
                    key[4 * i],
                    key[4 * i + 1],
                    key[4 * i + 2],
                    key[4 * i + 3],
                ]);
            }

            for i in 4..44 {
                let mut temp = w[i - 1];
                if i % 4 == 0 {
                    temp = Self::sub_word(Self::rot_word(temp)) ^ RCON[(i / 4) - 1];
                }
                w[i] = w[i - 4] ^ temp;
            }

            for (i, &word) in w.iter().enumerate() {
                round_keys[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes());
            }
        }

        fn sub_bytes(state: &mut [u8; BLOCK_SIZE]) {
            for b in state.iter_mut() {
                *b = SBOX[*b as usize];
            }
        }

        fn shift_rows(state: &mut [u8; BLOCK_SIZE]) {
            let temp = state[1];
            state[1] = state[5];
            state[5] = state[9];
            state[9] = state[13];
            state[13] = temp;

            state.swap(2, 10);
            state.swap(6, 14);

            let temp = state[15];
            state[15] = state[11];
            state[11] = state[7];
            state[7] = state[3];
            state[3] = temp;
        }

        #[inline(always)]
        fn xtime(b: u8) -> u8 {
            if (b & 0x80) != 0 {
                (b << 1) ^ 0x1b
            } else {
                b << 1
            }
        }

        fn mix_columns(state: &mut [u8; BLOCK_SIZE]) {
            for c in 0..4 {
                let i = c * 4;
                let s0 = state[i];
                let s1 = state[i + 1];
                let s2 = state[i + 2];
                let s3 = state[i + 3];

                let t = s0 ^ s1 ^ s2 ^ s3;
                let u = s0;

                state[i] ^= t ^ Self::xtime(s0 ^ s1);
                state[i + 1] ^= t ^ Self::xtime(s1 ^ s2);
                state[i + 2] ^= t ^ Self::xtime(s2 ^ s3);
                state[i + 3] ^= t ^ Self::xtime(s3 ^ u);
            }
        }

        fn add_round_key(&self, state: &mut [u8; BLOCK_SIZE], round: usize) {
            let offset = round * 16;
            for i in 0..16 {
                state[i] ^= self.round_keys[offset + i];
            }
        }

        /// Encrypts an individual 16-byte block.
        pub fn encrypt_block(&self, input: &[u8; BLOCK_SIZE], output: &mut [u8; BLOCK_SIZE]) {
            let mut state = *input;

            self.add_round_key(&mut state, 0);

            for round in 1..10 {
                Self::sub_bytes(&mut state);
                Self::shift_rows(&mut state);
                Self::mix_columns(&mut state);
                self.add_round_key(&mut state, round);
            }

            Self::sub_bytes(&mut state);
            Self::shift_rows(&mut state);
            self.add_round_key(&mut state, 10);

            *output = state;
        }
    }

    /// AES-128-CTR (Counter Mode) Stream Cipher.
    pub fn aes_128_ctr(key: &[u8; KEY_SIZE], iv: &[u8; 12], counter_start: u32, data: &[u8]) -> Vec<u8> {
        let cipher = Aes128::new(key);
        let mut output = Vec::with_capacity(data.len());
        let mut counter = counter_start;
        let mut block_keystream = [0u8; BLOCK_SIZE];
        let mut counter_block = [0u8; BLOCK_SIZE];
        counter_block[..12].copy_from_slice(iv);

        for chunk in data.chunks(BLOCK_SIZE) {
            counter_block[12..16].copy_from_slice(&counter.to_be_bytes());
            cipher.encrypt_block(&counter_block, &mut block_keystream);

            for (i, &b) in chunk.iter().enumerate() {
                output.push(b ^ block_keystream[i]);
            }
            counter = counter.wrapping_add(1);
        }

        output
    }
}

