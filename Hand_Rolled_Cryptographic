pub struct SecureSession<S: Read + Write> {
    stream: S,
    write_key: [u8; 16],
    read_key: [u8; 16],
    write_mac_key: [u8; 32],
    read_mac_key: [u8; 32],
    write_iv: [u8; 12],
    read_iv: [u8; 12],
    write_seq: u64,
    read_seq: u64,
}

impl<S: Read + Write> SecureSession<S> {
    pub fn new_client(stream: S, keys: protocol::SessionKeys) -> Self {
        SecureSession {
            stream,
            write_key: keys.client_write_key,
            read_key: keys.server_write_key,
            write_mac_key: keys.client_mac_key,
            read_mac_key: keys.server_mac_key,
            write_iv: keys.client_write_iv,
            read_iv: keys.server_write_iv,
            write_seq: 0,
            read_seq: 0,
        }
    }

    pub fn new_server(stream: S, keys: protocol::SessionKeys) -> Self {
        SecureSession {
            stream,
            write_key: keys.server_write_key,
            read_key: keys.client_write_key,
            write_mac_key: keys.server_mac_key,
            read_mac_key: keys.client_mac_key,
            write_iv: keys.server_write_iv,
            read_iv: keys.client_write_iv,
            write_seq: 0,
            read_seq: 0,
        }
    }

    /// Encrypts and transmits an authenticated record using Encrypt-then-MAC (EtM).
    pub fn send_encrypted(&mut self, content_type: protocol::ContentType, plaintext: &[u8]) -> Result<(), String> {
        let ciphertext = aes::aes_128_ctr(&self.write_key, &self.write_iv, self.write_seq as u32, plaintext);

        let mut mac_header = Vec::with_capacity(13 + ciphertext.len());
        mac_header.extend_from_slice(&self.write_seq.to_be_bytes());
        mac_header.push(content_type as u8);
        mac_header.extend_from_slice(&protocol::PROTOCOL_VERSION.to_be_bytes());
        mac_header.extend_from_slice(&(ciphertext.len() as u16).to_be_bytes());
        mac_header.extend_from_slice(&ciphertext);

        let tag = hmac::HmacSha256::mac(&self.write_mac_key, &mac_header);

        let mut wire_payload = Vec::with_capacity(ciphertext.len() + tag.len());
        wire_payload.extend_from_slice(&ciphertext);
        wire_payload.extend_from_slice(&tag);

        let frame = protocol::RecordFrame {
            content_type,
            version: protocol::PROTOCOL_VERSION,
            sequence_number: self.write_seq,
            payload: wire_payload,
        };

        let raw_bytes = frame.serialize();
        self.stream
            .write_all(&raw_bytes)
            .map_err(|e| format!("Failed to send record: {}", e))?;
        self.stream.flush().map_err(|e| format!("Flush error: {}", e))?;

        self.write_seq += 1;
        Ok(())
    }

    /// Receives, authenticates, and decrypts an incoming record frame.
    pub fn recv_encrypted(&mut self) -> Result<(protocol::ContentType, Vec<u8>), String> {
        let frame = protocol::RecordFrame::deserialize(&mut self.stream)?;

        if frame.sequence_number != self.read_seq {
            return Err(format!(
                "Replay Attack or Desynchronization detected! Expected seq {}, got {}",
                self.read_seq, frame.sequence_number
            ));
        }

        if frame.payload.len() < sha256::DIGEST_SIZE {
            return Err("Record payload too short to contain HMAC tag".to_string());
        }

        let split_pos = frame.payload.len() - sha256::DIGEST_SIZE;
        let ciphertext = &frame.payload[..split_pos];
        let received_tag = &frame.payload[split_pos..];

        let mut mac_header = Vec::with_capacity(13 + ciphertext.len());
        mac_header.extend_from_slice(&frame.sequence_number.to_be_bytes());
        mac_header.push(frame.content_type as u8);
        mac_header.extend_from_slice(&frame.version.to_be_bytes());
        mac_header.extend_from_slice(&(ciphertext.len() as u16).to_be_bytes());
        mac_header.extend_from_slice(ciphertext);

        if !hmac::HmacSha256::verify(&self.read_mac_key, &mac_header, received_tag) {
            return Err("Tampering Detected! Cryptographic MAC tag verification failed.".to_string());
        }

        let plaintext = aes::aes_128_ctr(&self.read_key, &self.read_iv, self.read_seq as u32, ciphertext);
        self.read_seq += 1;

        Ok((frame.content_type, plaintext))
    }
}

