// MODULE 5: SYSTEM ENTROPY COLLECTOR (CROSS-PLATFORM CSPRNG)
// ============================================================================

pub mod entropy {
    use super::bignum::BigUint;
    use super::sha256::Sha256;
    use std::io::Read;
    use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};

    pub fn fill_bytes(dest: &mut [u8]) {
        #[cfg(unix)]
        {
            if let Ok(mut file) = std::fs::File::open("/dev/urandom") {
                if file.read_exact(dest).is_ok() {
                    return;
                }
            }
        }

        // Fallback: Entropy extraction mixer via system telemetry
        let mut pool = Vec::new();
        let now = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap_or_else(|_| Duration::from_secs(0))
            .as_nanos();
        let instant = Instant::now().elapsed().as_nanos();
        let stack_ptr = &pool as *const _ as usize;

        pool.extend_from_slice(&now.to_le_bytes());
        pool.extend_from_slice(&instant.to_le_bytes());
        pool.extend_from_slice(&stack_ptr.to_le_bytes());

        let mut offset = 0;
        let mut counter = 0u64;

        while offset < dest.len() {
            let mut hasher = Sha256::new();
            hasher.update(&pool);
            hasher.update(&counter.to_le_bytes());
            let digest = hasher.finalize();

            let copy_len = std::cmp::min(dest.len() - offset, digest.len());
            dest[offset..offset + copy_len].copy_from_slice(&digest[..copy_len]);
            offset += copy_len;
            counter += 1;
        }
    }

    pub fn random_bytes(len: usize) -> Vec<u8> {
        let mut buf = vec![0u8; len];
        fill_bytes(&mut buf);
        buf
    }

    pub fn random_biguint(bits: usize) -> BigUint {
        let byte_len = (bits + 7) / 8;
        let mut bytes = random_bytes(byte_len);
        let excess_bits = (byte_len * 8) - bits;
        if excess_bits > 0 && !bytes.is_empty() {
            bytes[0] &= 0xFF >> excess_bits;
        }
        if !bytes.is_empty() {
            let high_bit_mask = 1 << ((bits - 1) % 8);
            bytes[0] |= high_bit_mask;
        }
        BigUint::from_be_bytes(&bytes)
    }
}

