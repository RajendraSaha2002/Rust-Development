pub mod protocol {
    use super::bignum::BigUint;
    use super::hmac::{hkdf_expand, HmacSha256};
    use super::sha256::Sha256;
    use std::io::Read;

    pub const PROTOCOL_VERSION: u16 = 0x0303; // TLS 1.2 semantic indicator

    #[repr(u8)]
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum ContentType {
        Handshake = 0x16,
        ApplicationData = 0x17,
        Alert = 0x15,
    }

    #[repr(u8)]
    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
    pub enum HandshakeType {
        ClientHello = 0x01,
        ServerHello = 0x02,
        ServerKeyExchange = 0x03,
        Finished = 0x14,
    }

    pub struct RecordFrame {
        pub content_type: ContentType,
        pub version: u16,
        pub sequence_number: u64,
        pub payload: Vec<u8>,
    }

    impl RecordFrame {
        pub fn serialize(&self) -> Vec<u8> {
            let mut out = Vec::with_capacity(13 + self.payload.len());
            out.push(self.content_type as u8);
            out.extend_from_slice(&self.version.to_be_bytes());
            out.extend_from_slice(&(self.payload.len() as u16).to_be_bytes());
            out.extend_from_slice(&self.sequence_number.to_be_bytes());
            out.extend_from_slice(&self.payload);
            out
        }

        pub fn deserialize<R: Read>(reader: &mut R) -> Result<Self, String> {
            let mut header = [0u8; 13];
            reader
                .read_exact(&mut header)
                .map_err(|e| format!("Failed to read record header: {}", e))?;

            let ct_byte = header[0];
            let content_type = match ct_byte {
                0x16 => ContentType::Handshake,
                0x17 => ContentType::ApplicationData,
                0x15 => ContentType::Alert,
                other => return Err(format!("Unknown ContentType: 0x{:02x}", other)),
            };

            let version = u16::from_be_bytes([header[1], header[2]]);
            let length = u16::from_be_bytes([header[3], header[4]]) as usize;
            let sequence_number = u64::from_be_bytes([
                header[5], header[6], header[7], header[8],
                header[9], header[10], header[11], header[12],
            ]);

            let mut payload = vec![0u8; length];
            reader
                .read_exact(&mut payload)
                .map_err(|e| format!("Truncated payload: {}", e))?;

            Ok(RecordFrame {
                content_type,
                version,
                sequence_number,
                payload,
            })
        }
    }

    pub struct SessionKeys {
        pub client_write_key: [u8; 16],
        pub server_write_key: [u8; 16],
        pub client_mac_key: [u8; 32],
        pub server_mac_key: [u8; 32],
        pub client_write_iv: [u8; 12],
        pub server_write_iv: [u8; 12],
    }

    impl SessionKeys {
        pub fn derive(shared_secret: &BigUint, client_random: &[u8], server_random: &[u8]) -> Self {
            let secret_bytes = shared_secret.to_be_bytes();
            let mut salt = Vec::with_capacity(client_random.len() + server_random.len());
            salt.extend_from_slice(client_random);
            salt.extend_from_slice(server_random);

            let prk = HmacSha256::mac(&salt, &secret_bytes);
            let key_material = hkdf_expand(&prk, b"MINI_TLS_KEY_EXPANSION", 120);

            let mut client_write_key = [0u8; 16];
            let mut server_write_key = [0u8; 16];
            let mut client_mac_key = [0u8; 32];
            let mut server_mac_key = [0u8; 32];
            let mut client_write_iv = [0u8; 12];
            let mut server_write_iv = [0u8; 12];

            client_write_key.copy_from_slice(&key_material[0..16]);
            server_write_key.copy_from_slice(&key_material[16..32]);
            client_mac_key.copy_from_slice(&key_material[32..64]);
            server_mac_key.copy_from_slice(&key_material[64..96]);
            client_write_iv.copy_from_slice(&key_material[96..108]);
            server_write_iv.copy_from_slice(&key_material[108..120]);

            SessionKeys {
                client_write_key,
                server_write_key,
                client_mac_key,
                server_mac_key,
                client_write_iv,
                server_write_iv,
            }
        }
    }

    #[derive(Clone)]
    pub struct Transcript {
        hasher: Sha256,
    }

    impl Transcript {
        pub fn new() -> Self {
            Transcript {
                hasher: Sha256::new(),
            }
        }

        pub fn update(&mut self, data: &[u8]) {
            self.hasher.update(data);
        }

        pub fn current_hash(&self) -> [u8; 32] {
            self.hasher.clone().finalize()
        }
    }
}

