// ============================================================================
// CONSTANT-TIME ARITHMETIC & EQUALITY UTILITIES
// ============================================================================

/// Constant-time byte slice comparison to eliminate timing side channels.
///
/// In standard `==`, the comparison returns `false` at the first mismatching byte.
/// An attacker measuring network round-trip timing can deduce characters byte-by-byte.
/// This function always checks every byte in O(N) time.
#[inline(never)]
pub fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut diff = 0u8;
    for (x, y) in a.iter().zip(b.iter()) {
        diff |= x ^ y;
    }
    diff == 0
}

