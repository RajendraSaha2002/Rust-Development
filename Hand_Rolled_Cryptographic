fn run_standalone_server(port: &str) {
    let bind_addr = format!("0.0.0.0:{}", port);
    let listener = TcpListener::bind(&bind_addr).expect("Failed to bind server listener");
    println!("[*] Mini-TLS Server listening on {}", bind_addr);

    for stream in listener.incoming() {
        match stream {
            Ok(socket) => {
                println!("[+] Incoming connection from {}", socket.peer_addr().unwrap());
                match HandshakeEngine::accept_handshake(socket) {
                    Ok(mut session) => {
                        println!("[+] Handshake established! Listening for encrypted records...");
                        loop {
                            match session.recv_encrypted() {
                                Ok((ct, msg)) => {
                                    let txt = String::from_utf8_lossy(&msg);
                                    println!(" [RX - {:?}] {}", ct, txt);
                                    let reply = format!("ACK: {}", txt);
                                    let _ = session.send_encrypted(protocol::ContentType::ApplicationData, reply.as_bytes());
                                }
                                Err(e) => {
                                    println!("[-] Session closed: {}", e);
                                    break;
                                }
                            }
                        }
                    }
                    Err(e) => eprintln!("[!] Handshake aborted: {}", e),
                }
            }
            Err(e) => eprintln!("[!] Accept error: {}", e),
        }
    }
}

fn run_standalone_client(addr: &str) {
    println!("[*] Connecting to Mini-TLS Server at {}", addr);
    let stream = TcpStream::connect(addr).expect("Could not connect to target server");
    match HandshakeEngine::connect_handshake(stream) {
        Ok(mut session) => {
            println!("[+] Handshake verified! Establishing secure application layer.");
            session
                .send_encrypted(protocol::ContentType::ApplicationData, b"Hello secure world!")
                .expect("Write error");
            let (_, reply) = session.recv_encrypted().expect("Read error");
            println!("[+] Server response: {}", String::from_utf8_lossy(&reply));
        }
        Err(e) => eprintln!("[!] Handshake failed: {}", e),
    }
}

fn run_full_inprocess_demo() {
    println!("===============================================================================");
    println!("        HAND-ROLLED CRYPTO ENGINE & MINI-TLS IN-PROCESS DEMONSTRATION          ");
    println!("===============================================================================");

    SecurityNarrator::print_security_analysis();

    let listener = TcpListener::bind("127.0.0.1:0").expect("Failed to bind ephemeral test socket");
    let local_addr = listener.local_addr().unwrap();
    println!("[*] Ephemeral test socket allocated on: {}", local_addr);

    let barrier = Arc::new(Barrier::new(2));
    let server_barrier = Arc::clone(&barrier);

    // --- SERVER THREAD ---
    let server_handle = thread::spawn(move || {
        server_barrier.wait();
        let (socket, _) = listener.accept().expect("Failed to accept socket connection");
        println!(" [SERVER] Received client connection. Beginning handshake state machine...");

        let start = Instant::now();
        let mut session = HandshakeEngine::accept_handshake(socket).expect("Server handshake failed");
        let elapsed = start.elapsed();
        println!(" [SERVER] Handshake completed successfully in {:.2?}!", elapsed);

        // Receive Client Message
        let (ct, payload) = session.recv_encrypted().expect("Server read failed");
        println!(
            " [SERVER] Decrypted Record: Type={:?}, Length={}, Content=\"{}\"",
            ct,
            payload.len(),
            String::from_utf8_lossy(&payload)
        );

        // Send Server Response
        let response = b"CONFIDENTIAL SERVER CONFIRMATION: Key exchange verified and integrity guaranteed.";
        session
            .send_encrypted(protocol::ContentType::ApplicationData, response)
            .expect("Server write failed");
        println!(" [SERVER] Encrypted reply transmitted.");
    });

    // --- CLIENT THREAD ---
    let client_handle = thread::spawn(move || {
        barrier.wait();
        let socket = TcpStream::connect(local_addr).expect("Client failed to connect");
        println!(" [CLIENT] Socket connected. Transmitting ClientHello with DH parameters...");

        let start = Instant::now();
        let mut session = HandshakeEngine::connect_handshake(socket).expect("Client handshake failed");
        let elapsed = start.elapsed();
        println!(" [CLIENT] Handshake completed successfully in {:.2?}!", elapsed);

        // Send Encrypted Application Data
        let message = b"CRITICAL CLIENT PAYLOAD: Transfer $100,000 to Account #84920";
        println!(
            " [CLIENT] Transmitting Encrypted Application Record: \"{}\"",
            String::from_utf8_lossy(message)
        );
        session
            .send_encrypted(protocol::ContentType::ApplicationData, message)
            .expect("Client write failed");

        // Receive Server Response
        let (ct, reply) = session.recv_encrypted().expect("Client read failed");
        println!(
            " [CLIENT] Decrypted Record from Server: Type={:?}, Content=\"{}\"",
            ct,
            String::from_utf8_lossy(&reply)
        );
    });

    server_handle.join().expect("Server thread panicked");
    client_handle.join().expect("Client thread panicked");

    println!("\n[*] Demonstration finished: Handshake negotiation, Diffie-Hellman derivation,");
    println!("    AES-128-CTR streaming, and Encrypt-then-MAC record authentication fully verified.");
}
