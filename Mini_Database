// 11. REPL CLIENT INTERFACE
// ============================================================================

pub fn start_repl(server_addr: &str) {
    println!("Connecting to BitForge Database at {}...", server_addr);
    let mut client = match DatabaseClient::connect(server_addr) {
        Ok(c) => c,
        Err(e) => {
            eprintln!("Connection failed: {}", e);
            return;
        }
    };

    println!("Connected! Type 'HELP' for available commands or 'EXIT' to quit.\n");
    let stdin = io::stdin();

    loop {
        print!("bitforge> ");
        io::stdout().flush().unwrap();

        let mut input = String::new();
        if stdin.read_line(&mut input).is_err() {
            break;
        }

        let trimmed = input.trim();
        if trimmed.is_empty() {
            continue;
        }

        let parts: Vec<&str> = trimmed.split_whitespace().collect();
        let cmd = parts[0].to_uppercase();

        match cmd.as_str() {
            "EXIT" | "QUIT" => {
                println!("Goodbye!");
                break;
            }
            "PING" => match client.ping() {
                Ok(res) => println!("{}", res),
                Err(e) => eprintln!("Error: {}", e),
            },
            "GET" => {
                if parts.len() < 2 {
                    println!("Usage: GET <key>");
                    continue;
                }
                match client.get(parts[1].as_bytes()) {
                    Ok(Some(val)) => println!("\"{}\"", String::from_utf8_lossy(&val)),
                    Ok(None) => println!("(nil)"),
                    Err(e) => eprintln!("Error: {}", e),
                }
            }
            "SET" => {
                if parts.len() < 3 {
                    println!("Usage: SET <key> <value>");
                    continue;
                }
                // Allow spaces inside value parameter
                let val_start = trimmed.find(parts[1]).unwrap() + parts[1].len();
                let value = trimmed[val_start..].trim();
                match client.set(parts[1].as_bytes(), value.as_bytes()) {
                    Ok(_) => println!("OK"),
                    Err(e) => eprintln!("Error: {}", e),
                }
            }
            "DEL" | "DELETE" => {
                if parts.len() < 2 {
                    println!("Usage: DEL <key>");
                    continue;
                }
                match client.delete(parts[1].as_bytes()) {
                    Ok(true) => println!("(integer) 1"),
                    Ok(false) => println!("(integer) 0"),
                    Err(e) => eprintln!("Error: {}", e),
                }
            }
            "COMPACT" => match client.compact() {
                Ok(res) => println!("Compact result: {}", res),
                Err(e) => eprintln!("Error: {}", e),
            },
            "STATS" => match client.stats() {
                Ok(res) => println!("{}", res),
                Err(e) => eprintln!("Error: {}", e),
            },
            "HELP" => {
                println!("Commands:");
                println!("  PING                      Test connection");
                println!("  GET <key>                 Retrieve value for key");
                println!("  SET <key> <value>         Store key-value pair");
                println!("  DEL <key>                 Delete key");
                println!("  COMPACT                   Trigger log compaction");
                println!("  STATS                     Display engine statistics");
                println!("  EXIT                      Quit REPL");
            }
            _ => {
                println!("Unknown command: '{}'. Type HELP for usage.", parts[0]);
            }
        }
    }
}

// ============================================================================
// 12. ENTRY POINT & CLI DISPATCHER
// ============================================================================

fn print_usage() {
    println!("BitForge Mini Key-Value Storage Engine");
    println!("Usage:");
    println!("  bitforge server [bind_addr] [wal_path]   Start TCP database server");
    println!("  bitforge client [server_addr]            Start interactive terminal REPL");
    println!("  bitforge bench [server_addr]             Run concurrent stress benchmark");
    println!("  bitforge test-crash                      Run crash-recovery and torn-write test");
    println!("");
    println!("Examples:");
    println!("  bitforge server 127.0.0.1:6379 ./data/db.wal");
    println!("  bitforge client 127.0.0.1:6379");
    println!("  bitforge bench 127.0.0.1:6379");
    println!("  bitforge test-crash");
}

fn main() {
    let args: Vec<String> = std::env::args().collect();

    if args.len() < 2 {
        print_usage();
        return;
    }

    match args[1].as_str() {
        "server" => {
            let bind_addr = args.get(2).cloned().unwrap_or_else(|| "127.0.0.1:6379".into());
            let wal_path = args.get(3).cloned().unwrap_or_else(|| "./data/engine.wal".into());

            println!("========================================================");
            println!("  Starting BitForge In-Memory Storage Engine");
            println!("========================================================");
            println!("WAL Log File: {}", wal_path);
            println!("Sync Policy : Every 100 writes + periodic fsync");
            println!("Compaction  : Auto trigger at 64MB & background timer");

            let config = EngineConfig {
                wal_path: PathBuf::from(wal_path),
                sync_policy: SyncPolicy::EveryN(100),
                auto_compact_threshold_bytes: 64 * 1024 * 1024, // 64 MB
            };

            let engine = match Engine::open(config) {
                Ok(eng) => Arc::new(eng),
                Err(e) => {
                    eprintln!("Fatal error opening database engine: {}", e);
                    std::process::exit(1);
                }
            };

            // Start periodic compaction worker every 60 seconds
            engine.start_periodic_compaction(Duration::from_secs(60));

            let server = DatabaseServer::new(engine, bind_addr);
            if let Err(e) = server.listen_and_serve() {
                eprintln!("Server shutdown error: {}", e);
            }
        }
        "client" => {
            let server_addr = args.get(2).cloned().unwrap_or_else(|| "127.0.0.1:6379".into());
            start_repl(&server_addr);
        }
        "bench" => {
            let server_addr = args.get(2).cloned().unwrap_or_else(|| "127.0.0.1:6379".into());
            run_benchmark(&server_addr, 8, 10_000);
        }
        "test-crash" => {
            run_crash_recovery_test();
        }
        _ => {
            print_usage();
        }
    }
}
