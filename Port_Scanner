        println!("FEATURES & DETECTION:");
        println!("    --no-banner                  Disable passive banner grabber.");
        println!("    --probe                      Enable active protocol-specific payload probes.");
        println!("    -v, --verbose                Enable verbose scanning diagnostic logs.");
        println!();
        println!("OUTPUT FORMATS:");
        println!("    --format <table|json|csv>    Report output format (Default: table)");
        println!("    -o, --output <FILE>          Export output directly to file path.");
        println!("    -h, --help                   Display this comprehensive help menu.");
        println!();
        println!("EXAMPLES:");
        println!("    net_recon -t 192.168.1.1 -p 22,80,443 --probe");
        println!("    net_recon -t scanme.nmap.org -p 1-1000 -w 100 --format json -o scan.json");
    }

    pub fn parse() -> Result<ScanConfig, String> {
        let args: Vec<String> = std::env::args().collect();
        if args.len() <= 1 {
            Self::print_help();
            std::process::exit(0);
        }

        let mut target = None;
        let mut ports_arg = "top100".to_string();
        let mut concurrency = DEFAULT_THREAD_COUNT;
        let mut timeout_ms = DEFAULT_TIMEOUT_MS;
        let mut banner_timeout_ms = DEFAULT_BANNER_TIMEOUT_MS;
        let mut delay_ms = DEFAULT_DELAY_MS;
        let mut grab_banners = true;
        let mut active_probing = false;
        let mut format = OutputFormat::Table;
        let mut output_file = None;
        let mut verbose = false;

        let mut idx = 1;
        while idx < args.len() {
            match args[idx].as_str() {
                "-h" | "--help" => {
                    Self::print_help();
                    std::process::exit(0);
                }
                "-t" | "--target" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --target".to_string());
                    }
                    target = Some(args[idx].clone());
                }
                "-p" | "--ports" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --ports".to_string());
                    }
                    ports_arg = args[idx].clone();
                }
                "-w" | "--workers" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --workers".to_string());
                    }
                    concurrency = args[idx].parse::<usize>().map_err(|_| "Invalid workers count")?;
                }
                "--timeout" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --timeout".to_string());
                    }
                    timeout_ms = args[idx].parse::<u64>().map_err(|_| "Invalid timeout integer")?;
                }
                "--banner-timeout" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --banner-timeout".to_string());
                    }
                    banner_timeout_ms = args[idx].parse::<u64>().map_err(|_| "Invalid banner-timeout integer")?;
                }
                "--delay" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --delay".to_string());
                    }
                    delay_ms = args[idx].parse::<u64>().map_err(|_| "Invalid delay parameter")?;
                }
                "--no-banner" => {
                    grab_banners = false;
                }
                "--probe" => {
                    active_probing = true;
                }
                "-v" | "--verbose" => {
                    verbose = true;
                }
                "--format" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --format".to_string());
                    }
                    match args[idx].to_lowercase().as_str() {
                        "table" => format = OutputFormat::Table,
                        "json" => format = OutputFormat::Json,
                        "csv" => format = OutputFormat::Csv,
                        other => return Err(format!("Unknown format: '{}'", other)),
                    }
                }
                "-o" | "--output" => {
                    idx += 1;
                    if idx >= args.len() {
                        return Err("Missing parameter for --output".to_string());
                    }
                    output_file = Some(args[idx].clone());
                }
                unknown => {
                    return Err(format!("Unrecognized CLI option: {}", unknown));
                }
            }
            idx += 1;
        }

        let target = target.ok_or("Target must be specified with -t or --target")?;

        // Resolve Target to an IP
        let target_ip = Self::resolve_host(&target)?;

        // Parse Ports
        let ports = Self::parse_ports(&ports_arg)?;

        if ports.is_empty() {
            return Err("Parsed port list is empty".to_string());
        }

        Ok(ScanConfig {
            target,
            target_ip,
            ports,
            concurrency,
            timeout: Duration::from_millis(timeout_ms),
            banner_timeout: Duration::from_millis(banner_timeout_ms),
            grab_banners,
            active_probing,
            output_format: format,
            output_file,
            delay_ms,
            verbose,
        })
    }

    fn resolve_host(target: &str) -> Result<IpAddr, String> {
        let lookup_str = format!("{}:80", target);
        match lookup_str.to_socket_addrs() {
            Ok(mut iter) => {
                if let Some(socket_addr) = iter.next() {
                    Ok(socket_addr.ip())
                } else {
                    Err(format!("Could not resolve domain: {}", target))
                }
            }
            Err(e) => Err(format!("DNS resolution failed for {}: {}", target, e)),
        }
    }

    fn parse_ports(input: &str) -> Result<Vec<u16>, String> {
        let input_trimmed = input.trim().to_lowercase();

        if input_trimmed == "top100" {
            return Ok(TOP_100_PORTS.to_vec());
        }

        if input_trimmed == "all" {
            return Ok((1..=65535).collect());
        }

        let mut ports = Vec::new();
        let segments = input.split(',');

        for segment in segments {
            let item = segment.trim();
            if item.is_empty() {
                continue;
            }

            if item.contains('-') {
                let parts: Vec<&str> = item.split('-').collect();
                if parts.len() != 2 {
                    return Err(format!("Invalid port range: {}", item));
                }

                let start = parts[0].trim().parse::<u16>().map_err(|_| format!("Invalid start port in {}", item))?;
                let end = parts[1].trim().parse::<u16>().map_err(|_| format!("Invalid end port in {}", item))?;

                if start > end {
                    return Err(format!("Start port {} is greater than end port {}", start, end));
                }

                for p in start..=end {
                    ports.push(p);
                }
            } else {
                let p = item.parse::<u16>().map_err(|_| format!("Invalid port number: {}", item))?;
                ports.push(p);
            }
        }

        ports.sort_unstable();
        ports.dedup();
        Ok(ports)
    }
}

// ============================================================================
// MAIN APPLICATION ORCHESTRATION PIPELINE
// ============================================================================

fn main() {
    let config = match CliParser::parse() {
        Ok(cfg) => cfg,
        Err(err) => {
            eprintln!("[ERROR] {}", err);
            eprintln!("Try 'net_recon --help' for details.");
            std::process::exit(1);
        }
    };

    Reporter::print_banner(&config);

    let total_ports = config.ports.len();
    let thread_pool = ThreadPool::new(config.concurrency);
    let (tx, rx) = mpsc::channel::<ScanResult>();

    let completed_counter = Arc::new(AtomicUsize::new(0));
    let open_counter = Arc::new(AtomicUsize::new(0));

    let scan_start = Instant::now();

    println!("[*] Commencing reconnaissance scan...");

    // Dispatch port scan jobs to the thread pool with optional rate limiting
    for &port in &config.ports {
        let tx = tx.clone();
        let target_ip = config.target_ip;
        let timeout = config.timeout;
        let banner_timeout = config.banner_timeout;
        let grab_banners = config.grab_banners;
        let active_probing = config.active_probing;
        let completed = Arc::clone(&completed_counter);
        let open_count = Arc::clone(&open_counter);
        let verbose = config.verbose;

        thread_pool.execute(move || {
            let result = Scanner::scan_port(
                target_ip,
                port,
                timeout,
                banner_timeout,
                grab_banners,
                active_probing,
            );

            let done = completed.fetch_add(1, Ordering::SeqCst) + 1;

            if result.state == PortState::Open {
                open_count.fetch_add(1, Ordering::SeqCst);
                println!(
                    " [+] Port {:<5} OPEN | Service: {:<12} | Latency: {:.2}ms",
                    result.port,
                    result.service_name,
                    result.latency.as_secs_f64() * 1000.0
                );
            } else if verbose {
                println!(" [-] Port {:<5} {}", result.port, result.state);
            }

            // Print progress indicator on clean terminal intervals
            if done % 100 == 0 || done == total_ports {
                let percent = (done as f64 / total_ports as f64) * 100.0;
                print!("\r[*] Progress: {:.1}% ({}/{} ports)", percent, done, total_ports);
                let _ = std::io::stdout().flush();
            }

            let _ = tx.send(result);
        });

        if config.delay_ms > 0 {
            thread::sleep(Duration::from_millis(config.delay_ms));
        }
    }

    // Drop the initial sender so receiver unblocks once all workers finish
    drop(tx);

    // Collect all port scanning results
    let mut results: Vec<ScanResult> = Vec::with_capacity(total_ports);
    for res in rx {
        results.push(res);
    }

    // Ensure results are ordered sequentially by port
    results.sort_by_key(|r| r.port);

    let duration = scan_start.elapsed();
    println!("\n[*] Scan pipeline finished in {:.2?}", duration);

    // Format output
    let rendered = match config.output_format {
        OutputFormat::Table => Reporter::format_table(&results, duration),
        OutputFormat::Json => Reporter::format_json(&results, &config.target, config.target_ip, duration),
        OutputFormat::Csv => Reporter::format_csv(&results),
    };

    // Print final report or save to destination file
    if let Some(ref path) = config.output_file {
        match std::fs::File::create(path) {
            Ok(mut file) => {
                if file.write_all(rendered.as_bytes()).is_ok() {
                    println!("[+] Report successfully exported to file: {}", path);
                } else {
                    eprintln!("[!] Failed to write contents to file: {}", path);
                }
            }
            Err(e) => {
                eprintln!("[!] Could not create output file {}: {}", path, e);
            }
        }
    } else {
        println!("{}", rendered);
    }

    let total_open = open_counter.load(Ordering::SeqCst);
    println!(
        "[*] Summary: Target {} had {} open ports out of {} probed.",
        config.target_ip, total_open, total_ports
    );
}

