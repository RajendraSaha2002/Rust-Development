pub struct Reporter;

impl Reporter {
    pub fn print_banner(config: &ScanConfig) {
        println!("===============================================================================");
        println!("              NET-RECON: CONCURRENT NETWORK RECONNAISSANCE TOOL               ");
        println!("===============================================================================");
        println!(" Target Address       : {} ({})", config.target, config.target_ip);
        println!(" Total Ports Queued   : {}", config.ports.len());
        println!(" Concurrency Cap      : {} worker threads", config.concurrency);
        println!(" Connect Timeout      : {:?}", config.timeout);
        println!(" Banner Timeout       : {:?}", config.banner_timeout);
        println!(" Inter-Packet Delay   : {} ms", config.delay_ms);
        println!(" Banner Grabbing      : {}", if config.grab_banners { "ENABLED" } else { "DISABLED" });
        println!(" Active Probing       : {}", if config.active_probing { "ENABLED" } else { "DISABLED" });
        println!(" Output Formatting    : {:?}", config.output_format);
        println!("===============================================================================");
    }

    pub fn format_table(results: &[ScanResult], total_duration: Duration) -> String {
        let mut out = String::new();
        out.push_str("\n+-------+--------+-----------------+-----------------------+------------------------------------------+\n");
        out.push_str("| PORT  | STATE  | SERVICE         | LATENCY (ms)          | FINGERPRINT / BANNER PREVIEW             |\n");
        out.push_str("+-------+--------+-----------------+-----------------------+------------------------------------------+\n");

        for res in results.iter().filter(|r| r.state == PortState::Open) {
            let banner_preview = if let Some(ref b) = res.banner {
                let first_line = b.lines().next().unwrap_or("").trim();
                if first_line.chars().count() > 40 {
                    let truncated: String = first_line.chars().take(37).collect();
                    format!("{}...", truncated)
                } else {
                    first_line.to_string()
                }
            } else if !res.fingerprint.is_empty() {
                if res.fingerprint.chars().count() > 40 {
                    let truncated: String = res.fingerprint.chars().take(37).collect();
                    format!("{}...", truncated)
                } else {
                    res.fingerprint.clone()
                }
            } else {
                "-".to_string()
            };

            let service_field = if res.service_name.chars().count() > 15 {
                let truncated: String = res.service_name.chars().take(12).collect();
                format!("{}...", truncated)
            } else {
                res.service_name.clone()
            };

            let latency_str = format!("{:.2}", res.latency.as_secs_f64() * 1000.0);

            out.push_str(&format!(
                "| {:<5} | {:<6} | {:<15} | {:<21} | {:<40} |\n",
                res.port,
                res.state.to_string(),
                service_field,
                latency_str,
                banner_preview
            ));
        }

        out.push_str("+-------+--------+-----------------+-----------------------+------------------------------------------+\n");
        out.push_str(&format!("Scan completed in: {:.2?}\n", total_duration));
        out
    }

    pub fn format_csv(results: &[ScanResult]) -> String {
        let mut out = String::new();
        out.push_str("port,state,service,latency_ms,fingerprint,banner\n");

        for r in results.iter().filter(|r| r.state == PortState::Open) {
            let clean_banner = r
                .banner
                .as_deref()
                .unwrap_or("")
                .replace('"', "\"\"")
                .replace('\n', " ");

            let clean_fp = r.fingerprint.replace('"', "\"\"");

            out.push_str(&format!(
                "{},\"{}\",\"{}\",{:.3},\"{}\",\"{}\"\n",
                r.port,
                r.state,
                r.service_name,
                r.latency.as_secs_f64() * 1000.0,
                clean_fp,
                clean_banner
            ));
        }
        out
    }

    /// Compliant JSON serialization written entirely without Serde.
    pub fn format_json(results: &[ScanResult], target: &str, target_ip: IpAddr, duration: Duration) -> String {
        let mut out = String::new();
        out.push_str("{\n");
        out.push_str(&format!("  \"target\": \"{}\",\n", Self::escape_json(target)));
        out.push_str(&format!("  \"ip\": \"{}\",\n", target_ip));
        out.push_str(&format!("  \"duration_ms\": {},\n", duration.as_millis()));
        out.push_str("  \"open_ports\": [\n");

        let open_results: Vec<&ScanResult> = results.iter().filter(|r| r.state == PortState::Open).collect();

        for (idx, r) in open_results.iter().enumerate() {
            out.push_str("    {\n");
            out.push_str(&format!("      \"port\": {},\n", r.port));
            out.push_str(&format!("      \"state\": \"{}\",\n", r.state));
            out.push_str(&format!("      \"service\": \"{}\",\n", Self::escape_json(&r.service_name)));
            out.push_str(&format!("      \"latency_ms\": {:.3},\n", r.latency.as_secs_f64() * 1000.0));
            out.push_str(&format!("      \"fingerprint\": \"{}\",\n", Self::escape_json(&r.fingerprint)));

            match &r.banner {
                Some(b) => out.push_str(&format!("      \"banner\": \"{}\"\n", Self::escape_json(b))),
                None => out.push_str("      \"banner\": null\n"),
            }

            if idx + 1 == open_results.len() {
                out.push_str("    }\n");
            } else {
                out.push_str("    },\n");
            }
        }

        out.push_str("  ]\n");
        out.push_str("}\n");
        out
    }

    fn escape_json(input: &str) -> String {
        let mut escaped = String::with_capacity(input.len());
        for c in input.chars() {
            match c {
                '"' => escaped.push_str("\\\""),
                '\\' => escaped.push_str("\\\\"),
                '\x08' => escaped.push_str("\\b"),
                '\x0c' => escaped.push_str("\\f"),
                '\n' => escaped.push_str("\\n"),
                '\r' => escaped.push_str("\\r"),
                '\t' => escaped.push_str("\\t"),
                '\x00'..='\x1f' => escaped.push_str(&format!("\\u{:04x}", c as u32)),
                _ => escaped.push(c),
            }
        }
        escaped
    }
}

