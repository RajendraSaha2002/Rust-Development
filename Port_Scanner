pub struct Fingerprinter;

impl Fingerprinter {
    /// Maps a well-known port to its default service name.
    pub fn lookup_port_name(port: u16) -> &'static str {
        match port {
            20 => "ftp-data",
            21 => "ftp",
            22 => "ssh",
            23 => "telnet",
            25 => "smtp",
            43 => "whois",
            53 => "domain (dns)",
            67 => "bootps",
            68 => "bootpc",
            69 => "tftp",
            79 => "finger",
            80 => "http",
            88 => "kerberos",
            110 => "pop3",
            111 => "rpcbind",
            119 => "nntp",
            123 => "ntp",
            135 => "msrpc",
            137 => "netbios-ns",
            138 => "netbios-dgm",
            139 => "netbios-ssn",
            143 => "imap",
            161 => "snmp",
            162 => "snmptrap",
            179 => "bgp",
            194 => "irc",
            389 => "ldap",
            443 => "https",
            445 => "microsoft-ds",
            465 => "smtps",
            514 => "syslog",
            515 => "printer (lpd)",
            587 => "submission",
            631 => "ipp",
            636 => "ldaps",
            873 => "rsync",
            990 => "ftps",
            993 => "imaps",
            995 => "pop3s",
            1080 => "socks",
            1433 => "ms-sql-s",
            1521 => "oracle",
            1723 => "pptp",
            2049 => "nfs",
            2121 => "ccproxy-ftp",
            3306 => "mysql",
            3389 => "ms-wbt-server (rdp)",
            5432 => "postgresql",
            5672 => "amqp",
            5900 => "vnc",
            6379 => "redis",
            6667 => "irc",
            8000 => "http-alt",
            8080 => "http-proxy",
            8443 => "https-alt",
            8888 => "http-alt",
            9000 => "cslistener",
            9092 => "kafka",
            9200 => "elasticsearch",
            11211 => "memcached",
            27017 => "mongodb",
            _ => "unknown",
        }
    }

    /// Evaluates raw banner bytes and heuristics to fingerprint services.
    pub fn identify(port: u16, banner: Option<&str>) -> (String, String) {
        let base_service = Self::lookup_port_name(port).to_string();

        let banner_str = match banner {
            Some(b) if !b.trim().is_empty() => b,
            _ => return (base_service, "No banner available".to_string()),
        };

        let upper = banner_str.to_uppercase();

        // 1. SSH Fingerprint matching
        if banner_str.starts_with("SSH-") {
            let details = banner_str.lines().next().unwrap_or(banner_str).trim();
            return ("ssh".to_string(), format!("SSH Protocol ({})", details));
        }

        // 2. HTTP Server matching
        if upper.contains("HTTP/1.") || upper.contains("HTTP/2.") || upper.contains("<HTML") {
            let server_name = banner_str
                .lines()
                .find(|l| l.to_lowercase().starts_with("server:"))
                .map(|l| l[7..].trim())
                .unwrap_or("Generic Web Server");

            return ("http".to_string(), format!("HTTP Server ({})", server_name));
        }

        // 3. FTP Server matching
        if banner_str.starts_with("220") && (upper.contains("FTP") || upper.contains("FILEZILLA")) {
            let first_line = banner_str.lines().next().unwrap_or(banner_str).trim();
            return ("ftp".to_string(), format!("FTP Service ({})", first_line));
        }

        // 4. SMTP Server matching
        if banner_str.starts_with("220") && (upper.contains("SMTP") || upper.contains("POSTFIX") || upper.contains("MAIL")) {
            let first_line = banner_str.lines().next().unwrap_or(banner_str).trim();
            return ("smtp".to_string(), format!("SMTP Mail Transfer ({})", first_line));
        }

        // 5. Redis matching
        if banner_str.starts_with("-ERR") || banner_str.starts_with("+PONG") || upper.contains("REDIS") {
            return ("redis".to_string(), "Redis Key-Value Store".to_string());
        }

        // 6. MySQL matching
        if banner_str.contains("mysql_native_password") || banner_str.contains("mariadb") {
            return ("mysql".to_string(), "MySQL/MariaDB Database Handshake".to_string());
        }

        // 7. VNC matching
        if banner_str.starts_with("RFB ") {
            let version = banner_str.trim();
            return ("vnc".to_string(), format!("VNC Protocol ({})", version));
        }

        (base_service, "Generic Service (heuristic match)".to_string())
    }
}

// ============================================================================
// PROBING & BANNER GRABBING ENGINE
// ============================================================================

pub struct BannerGrabber;

impl BannerGrabber {
    /// Sanitizes raw network bytes into clean, displayable ASCII strings.
    pub fn sanitize_bytes(buffer: &[u8]) -> String {
        let mut clean = String::with_capacity(buffer.len());
        for &byte in buffer {
            match byte {
                b'\r' => (),
                b'\n' => clean.push('\n'),
                b'\t' => clean.push('\t'),
                0x20..=0x7E => clean.push(byte as char),
                _ => clean.push('.'),
            }
        }
        clean.trim().to_string()
    }

    /// Attempts to read greeting banners; if silent, pushes specific protocol probes.
    pub fn capture(stream: &mut TcpStream, port: u16, timeout: Duration, active_probing: bool) -> Option<String> {
        let _ = stream.set_read_timeout(Some(timeout));
        let _ = stream.set_write_timeout(Some(timeout));

        let mut buffer = [0u8; MAX_BANNER_SIZE];

        // Phase 1: Passive Listen (Services like SSH, FTP, SMTP speak first)
        if let Ok(bytes_read) = stream.read(&mut buffer) {
            if bytes_read > 0 {
                return Some(Self::sanitize_bytes(&buffer[..bytes_read]));
            }
        }

        if !active_probing {
            return None;
        }

        // Phase 2: Active Targeted Probing
        let probe_payload: &[u8] = match port {
            80 | 8080 | 8000 | 8888 => b"HEAD / HTTP/1.0\r\nUser-Agent: NetRecon/1.0\r\n\r\n",
            443 | 8443 => {
                // TLS Client Hello minimal prefix
                b"\x16\x03\x01\x00\x7a\x01\x00\x00\x76\x03\x03"
            }
            21 => b"HELP\r\n",
            25 | 587 => b"EHLO netrecon.local\r\n",
            110 => b"CAPA\r\n",
            143 => b"A001 CAPABILITY\r\n",
            6379 => b"PING\r\n",
            _ => b"\r\n\r\n\r\n",
        };

        if stream.write_all(probe_payload).is_ok() {
            let _ = stream.flush();
            if let Ok(bytes_read) = stream.read(&mut buffer) {
                if bytes_read > 0 {
                    return Some(Self::sanitize_bytes(&buffer[..bytes_read]));
                }
            }
        }

        None
    }
}

// ============================================================================
// SCANNER ENGINE
// ============================================================================

pub struct Scanner;

impl Scanner {
    /// Executes a single TCP Connect timeout scan against the socket address.
    pub fn scan_port(
        target_ip: IpAddr,
        port: u16,
        timeout: Duration,
        banner_timeout: Duration,
        grab_banners: bool,
        active_probing: bool,
    ) -> ScanResult {
        let socket_addr = SocketAddr::new(target_ip, port);
        let start_time = Instant::now();

        match TcpStream::connect_timeout(&socket_addr, timeout) {
            Ok(mut stream) => {
                let latency = start_time.elapsed();
                let mut banner = None;

                if grab_banners {
                    banner = BannerGrabber::capture(&mut stream, port, banner_timeout, active_probing);
                }

                let (service_name, fingerprint) =
                    Fingerprinter::identify(port, banner.as_deref());

                ScanResult {
                    port,
                    state: PortState::Open,
                    latency,
                    banner,
                    service_name,
                    fingerprint,
                }
            }
            Err(ref e) => {
                let state = match e.kind() {
                    std::io::ErrorKind::ConnectionRefused => PortState::Closed,
                    std::io::ErrorKind::TimedOut => PortState::Filtered,
                    _ => PortState::Filtered,
                };

                let service_name = Fingerprinter::lookup_port_name(port).to_string();

                ScanResult {
                    port,
                    state,
                    latency: start_time.elapsed(),
                    banner: None,
                    service_name,
                    fingerprint: String::new(),
                }
            }
        }
    }
}

