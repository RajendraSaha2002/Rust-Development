#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_port_parse_single() {
        let p = CliParser::parse_ports("80").unwrap();
        assert_eq!(p, vec![80]);
    }

    #[test]
    fn test_port_parse_range() {
        let p = CliParser::parse_ports("20-23").unwrap();
        assert_eq!(p, vec![20, 21, 22, 23]);
    }

    #[test]
    fn test_port_parse_mixed() {
        let p = CliParser::parse_ports("22,80-82,443").unwrap();
        assert_eq!(p, vec![22, 80, 81, 82, 443]);
    }

    #[test]
    fn test_port_parse_top100() {
        let p = CliParser::parse_ports("top100").unwrap();
        assert_eq!(p.len(), TOP_100_PORTS.len());
        assert!(p.contains(&80));
        assert!(p.contains(&443));
    }

    #[test]
    fn test_sanitize_bytes() {
        let dirty = b"SSH-2.0-OpenSSH_8.9p1\r\n\x00\x01test";
        let clean = BannerGrabber::sanitize_bytes(dirty);
        assert_eq!(clean, "SSH-2.0-OpenSSH_8.9p1\n..test");
    }

    #[test]
    fn test_fingerprint_ssh() {
        let banner = "SSH-2.0-OpenSSH_8.2p1 Ubuntu-4ubuntu0.5";
        let (svc, fp) = Fingerprinter::identify(22, Some(banner));
        assert_eq!(svc, "ssh");
        assert!(fp.contains("OpenSSH_8.2p1"));
    }

    #[test]
    fn test_fingerprint_http() {
        let banner = "HTTP/1.1 200 OK\r\nServer: nginx/1.18.0\r\nContent-Type: text/html";
        let (svc, fp) = Fingerprinter::identify(80, Some(banner));
        assert_eq!(svc, "http");
        assert!(fp.contains("nginx/1.18.0"));
    }

    #[test]
    fn test_threadpool_execution() {
        let pool = ThreadPool::new(4);
        let counter = Arc::new(AtomicUsize::new(0));

        for _ in 0..10 {
            let c = Arc::clone(&counter);
            pool.execute(move || {
                c.fetch_add(1, Ordering::SeqCst);
            });
        }

        // Drop forces all threads to finish their jobs
        drop(pool);
        assert_eq!(counter.load(Ordering::SeqCst), 10);
    }

    #[test]
    fn test_json_escaping() {
        let raw = "Hello \"World\"\nLine 2\\Test";
        let escaped = Reporter::escape_json(raw);
        assert_eq!(escaped, "Hello \\\"World\\\"\\nLine 2\\\\Test");
    }
}
