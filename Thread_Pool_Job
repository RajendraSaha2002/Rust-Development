//! # Industrial-Strength Priority Thread Pool & Job Scheduler
//!
//! A production-grade multi-threaded task orchestration system using strictly
//! Rust standard library primitives (`std::sync`, `std::thread`, `std::collections`).
//!
//! Features:
//! - Configurable fixed-size worker pool with panic recovery and worker respawning.
//! - Priority-ordered task dispatching (Critical, High, Normal, Low, Idle) with FIFO tie-breaking.
//! - Timer-based delayed execution and recurring schedules using a Min-Heap keyed on `Instant`.
//! - Condition variable (`Condvar`) thread parking with mutex poison recovery.
//! - Typed `JobHandle<T>` abstraction supporting blocking joins, timeouts, and non-blocking polling.
//! - Deterministic graceful shutdown draining all in-flight and queued operations.

use std::any::Any;
use std::cmp::Ordering;
use std::collections::BinaryHeap;
use std::fmt;
use std::panic::{catch_unwind, AssertUnwindSafe};
use std::sync::atomic::{AtomicBool, AtomicU64, Ordering as AtomicOrdering};
use std::sync::mpsc::{channel, Receiver, RecvTimeoutError, Sender};
use std::sync::{Arc, Condvar, Mutex, MutexGuard};
use std::thread::{self, JoinHandle};
use std::time::{Duration, Instant};

