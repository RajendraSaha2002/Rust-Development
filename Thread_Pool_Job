        let tag_str = tag.to_string();
        let handle = pool.submit_with_priority(prio, move || {
            thread::sleep(Duration::from_millis(15));
            let mut guard = order_tracker.lock().unwrap();
            guard.push(tag_str.clone());
            println!("  ⚡ Executed {} with Priority: {}", tag_str, prio);
            prio
        });
        handles.push(handle);
    }

    for h in handles {
        let _ = h.join();
    }

    // ------------------------------------------------------------------------
    // TEST 2: Delayed Scheduling (Min-Heap Execution by Deadline)
    // ------------------------------------------------------------------------
    println!("\n--- [TEST 2] Delayed Execution Verification ---");
    let start_instant = Instant::now();

    let d3 = pool.schedule_after(Duration::from_millis(300), Priority::High, move || {
        println!("  🕒 [T+300ms Task] Executed at: {:?}", start_instant.elapsed());
        300
    });

    let d1 = pool.schedule_after(Duration::from_millis(100), Priority::Normal, move || {
        println!("  🕒 [T+100ms Task] Executed at: {:?}", start_instant.elapsed());
        100
    });

    let d2 = pool.schedule_after(Duration::from_millis(200), Priority::Critical, move || {
        println!("  🕒 [T+200ms Task] Executed at: {:?}", start_instant.elapsed());
        200
    });

    assert_eq!(d1.join().unwrap(), 100);
    assert_eq!(d2.join().unwrap(), 200);
    assert_eq!(d3.join().unwrap(), 300);

    // ------------------------------------------------------------------------
    // TEST 3: Periodic / Recurring Task Scheduling & Dynamic Cancellation
    // ------------------------------------------------------------------------
    println!("\n--- [TEST 3] Recurring Task Scheduling & Cancellation ---");
    let tick_counter = Arc::new(AtomicU64::new(0));
    let tick_clone = Arc::clone(&tick_counter);

    let recurring_handle = pool.schedule_repeating(
        Duration::from_millis(50),
        Duration::from_millis(50),
        Priority::High,
        move || {
            let current = tick_clone.fetch_add(1, AtomicOrdering::SeqCst) + 1;
            println!("  🔁 [Heartbeat Tick #{}]", current);
        },
    );

    thread::sleep(Duration::from_millis(220));
    recurring_handle.cancel();
    println!("  🛑 Cancelled Recurring Task #{}. Verifying quiet state...", recurring_handle.id());
    let ticks_at_cancel = tick_counter.load(AtomicOrdering::SeqCst);
    thread::sleep(Duration::from_millis(120));
    let ticks_after_wait = tick_counter.load(AtomicOrdering::SeqCst);
    assert_eq!(ticks_at_cancel, ticks_after_wait, "Cancelled task ticked after cancellation!");
    println!("  ✅ Cancellation confirmed. No lingering invocations.");

    // ------------------------------------------------------------------------
    // TEST 4: Panic Isolation & Worker Resilience
    // ------------------------------------------------------------------------
    println!("\n--- [TEST 4] Panic Boundary & Thread Resilience ---");
    let panic_handle = pool.submit(|| {
        println!("  💥 Inducing controlled worker panic!");
        panic!("Fatal internal transaction failure simulated!");
    });

    match panic_handle.join() {
        Err(JobError::Panicked(msg)) => {
            println!("  🛡️ Caught panic via JobHandle successfully: '{}'", msg);
        }
        _ => panic!("Expected panic error was not captured!"),
    }

    let sanity_handle = pool.submit(|| {
        println!("  🌟 Sanity check: Pool remains active and processed this subsequent task!");
        42
    });
    assert_eq!(sanity_handle.join().unwrap(), 42);

    // ------------------------------------------------------------------------
    // TEST 5: Graceful Shutdown (Draining In-Flight & Queued Operations)
    // ------------------------------------------------------------------------
    println!("\n--- [TEST 5] Graceful Shutdown & Work Draining ---");
    let drain_accumulator = Arc::new(AtomicU64::new(0));
    let batch_size = 30;

    for _ in 0..batch_size {
        let acc = Arc::clone(&drain_accumulator);
        pool.execute_with_priority(Priority::Normal, move || {
            thread::sleep(Duration::from_millis(5));
            acc.fetch_add(1, AtomicOrdering::Relaxed);
        });
    }

    println!("  Queued {} jobs. Initiating pool.shutdown()...", batch_size);
    let shutdown_start = Instant::now();
    pool.shutdown();
    let shutdown_duration = shutdown_start.elapsed();

    let processed = drain_accumulator.load(AtomicOrdering::SeqCst);
    println!("  Drained completed tasks: {}/{}", processed, batch_size);
    println!("  Shutdown completed cleanly in: {:?}", shutdown_duration);
    assert_eq!(processed, batch_size, "Shutdown dropped queued work!");

    println!("\n============================================================");
    println!("🎉 ALL TESTS PASSED: Zero leaks, zero dropped work, full recovery.");
    println!("============================================================");
}
