#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
#[repr(u8)]
pub enum Priority {
    Idle = 0,
    Low = 1,
    Normal = 2,
    High = 3,
    Critical = 4,
}

impl fmt::Display for Priority {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            Priority::Idle => write!(f, "IDLE"),
            Priority::Low => write!(f, "LOW"),
            Priority::Normal => write!(f, "NORMAL"),
            Priority::High => write!(f, "HIGH"),
            Priority::Critical => write!(f, "CRITICAL"),
        }
    }
}

#[derive(Debug)]
pub enum JobError {
    Panicked(String),
    Cancelled,
    Timeout,
    PoolShutdown,
}

impl fmt::Display for JobError {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            JobError::Panicked(msg) => write!(f, "Job panicked during execution: {}", msg),
            JobError::Cancelled => write!(f, "Job was cancelled before execution"),
            JobError::Timeout => write!(f, "Timed out waiting for job completion"),
            JobError::PoolShutdown => write!(f, "Thread pool has shut down"),
        }
    }
}

impl std::error::Error for JobError {}

// ============================================================================
// PROMISE / FUTURE ABSTRACTION (JobHandle)
// ============================================================================

struct SharedPromiseState<T> {
    result: Option<Result<T, JobError>>,
    is_completed: bool,
}

/// A handle representing an in-flight or scheduled computation.
pub struct JobHandle<T> {
    state: Arc<(Mutex<SharedPromiseState<T>>, Condvar)>,
}

impl<T> JobHandle<T> {
    fn new() -> (Self, PromiseCompleter<T>) {
        let state = Arc::new((
            Mutex::new(SharedPromiseState {
                result: None,
                is_completed: false,
            }),
            Condvar::new(),
        ));

        let handle = JobHandle {
            state: Arc::clone(&state),
        };
        let completer = PromiseCompleter { state };
        (handle, completer)
    }

    /// Blocks until the computation completes and yields the result.
    pub fn join(self) -> Result<T, JobError> {
        let (lock, cvar) = &*self.state;
        let mut guard = match lock.lock() {
            Ok(g) => g,
            Err(poisoned) => poisoned.into_inner(),
        };

        while !guard.is_completed {
            guard = match cvar.wait(guard) {
                Ok(g) => g,
                Err(poisoned) => poisoned.into_inner(),
            };
        }

        guard
            .result
            .take()
            .unwrap_or(Err(JobError::Cancelled))
    }

    /// Blocks with a maximum duration timeout.
    pub fn join_timeout(self, timeout: Duration) -> Result<T, JobError> {
        let (lock, cvar) = &*self.state;
        let mut guard = match lock.lock() {
            Ok(g) => g,
            Err(poisoned) => poisoned.into_inner(),
        };

        let start = Instant::now();
        while !guard.is_completed {
            let elapsed = start.elapsed();
            if elapsed >= timeout {
                return Err(JobError::Timeout);
            }
            let remaining = timeout - elapsed;
            let (new_guard, wait_res) = match cvar.wait_timeout(guard, remaining) {
                Ok(res) => res,
                Err(poisoned) => poisoned.into_inner(),
            };
            guard = new_guard;
            if wait_res.timed_out() && !guard.is_completed {
                return Err(JobError::Timeout);
            }
        }

        guard
            .result
            .take()
            .unwrap_or(Err(JobError::Cancelled))
    }

    /// Non-blocking check for task readiness.
    pub fn is_finished(&self) -> bool {
        let (lock, _) = &*self.state;
        let guard = match lock.lock() {
            Ok(g) => g,
            Err(poisoned) => poisoned.into_inner(),
        };
        guard.is_completed
    }
}

struct PromiseCompleter<T> {
    state: Arc<(Mutex<SharedPromiseState<T>>, Condvar)>,
}

impl<T> PromiseCompleter<T> {
    fn complete(self, result: Result<T, JobError>) {
        let (lock, cvar) = &*self.state;
        let mut guard = match lock.lock() {
            Ok(g) => g,
            Err(poisoned) => poisoned.into_inner(),
        };
        guard.result = Some(result);
        guard.is_completed = true;
        cvar.notify_all();
    }
}

// ============================================================================
// RECURRING TASK CONTROLLER
// ============================================================================

/// Token allowing cancellation of an active periodic task.
#[derive(Clone, Debug)]
pub struct RecurringHandle {
    task_id: u64,
    cancelled: Arc<AtomicBool>,
}

impl RecurringHandle {
    pub fn cancel(&self) {
        self.cancelled.store(true, AtomicOrdering::SeqCst);
    }

    pub fn is_cancelled(&self) -> bool {
        self.cancelled.load(AtomicOrdering::SeqCst)
    }

    pub fn id(&self) -> u64 {
        self.task_id
    }
}

// ============================================================================
// WORK QUEUE STRUCTURES & ORDERING
// ============================================================================

type TaskClosure = Box<dyn FnOnce() + Send + 'static>;

struct ReadyJob {
    priority: Priority,
    sequence: u64,
    task: TaskClosure,
}

impl Ord for ReadyJob {
    fn cmp(&self, other: &Self) -> Ordering {
        // High priority first. On priority equality: FIFO (smaller sequence number first)
        self.priority
            .cmp(&other.priority)
            .then_with(|| other.sequence.cmp(&self.sequence))
    }
}

impl PartialOrd for ReadyJob {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl PartialEq for ReadyJob {
    fn eq(&self, other: &Self) -> bool {
        self.priority == other.priority && self.sequence == other.sequence
    }
}

impl Eq for ReadyJob {}

struct ScheduledJob {
    execute_at: Instant,
    sequence: u64,
    priority: Priority,
    recurring_period: Option<Duration>,
    cancellation_token: Option<Arc<AtomicBool>>,
    task_generator: Box<dyn Fn() -> TaskClosure + Send + 'static>,
}

impl Ord for ScheduledJob {
    fn cmp(&self, other: &Self) -> Ordering {
        // Min-Heap based on execute_at (earliest instant is Greater for BinaryHeap)
        other
            .execute_at
            .cmp(&self.execute_at)
            .then_with(|| other.sequence.cmp(&self.sequence))
    }
}

impl PartialOrd for ScheduledJob {
    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl PartialEq for ScheduledJob {
    fn eq(&self, other: &Self) -> bool {
        self.execute_at == other.execute_at && self.sequence == other.sequence
    }
}

impl Eq for ScheduledJob {}

// ============================================================================
// SYNCHRONIZED PRIORITY WORK QUEUE (Worker Pool Target)
// ============================================================================

struct SharedWorkerQueue {
    heap: BinaryHeap<ReadyJob>,
    active_workers: usize,
    draining: bool,
    terminated: bool,
}

pub struct WorkerQueue {
    state: Mutex<SharedWorkerQueue>,
    has_work_cvar: Condvar,
    drain_complete_cvar: Condvar,
}

impl WorkerQueue {
    fn new() -> Self {
        Self {
            state: Mutex::new(SharedWorkerQueue {
                heap: BinaryHeap::new(),
                active_workers: 0,
                draining: false,
                terminated: false,
            }),
            has_work_cvar: Condvar::new(),
            drain_complete_cvar: Condvar::new(),
        }
    }

    fn push(&self, job: ReadyJob) {
        let mut guard = Self::lock_robust(&self.state);
        if guard.terminated {
            return;
        }
        guard.heap.push(job);
        self.has_work_cvar.notify_one();
    }

    fn lock_robust<T>(mutex: &Mutex<T>) -> MutexGuard<'_, T> {
        match mutex.lock() {
            Ok(g) => g,
            Err(poisoned) => {
                eprintln!("[WARN] Recovered poisoned mutex lock in WorkerQueue");
                poisoned.into_inner()
            }
        }
    }
}

// ============================================================================
// SCHEDULER COMMAND PROTOCOL
// ============================================================================

enum SchedulerCommand {
    Schedule(ScheduledJob),
    DispatchImmediate(ReadyJob),
    InitiateDrain,
    TerminateNow,
}

// ============================================================================
// THREAD POOL & SCHEDULER ENGINE
// ============================================================================

pub struct ThreadPool {
    worker_queue: Arc<WorkerQueue>,
    scheduler_tx: Mutex<Option<Sender<SchedulerCommand>>>,
    worker_threads: Mutex<Vec<JoinHandle<()>>>,
    scheduler_thread: Mutex<Option<JoinHandle<()>>>,
    next_sequence: Arc<AtomicU64>,
    next_task_id: Arc<AtomicU64>,
    total_completed: Arc<AtomicU64>,
    total_panicked: Arc<AtomicU64>,
    worker_count: usize,
}

impl ThreadPool {
    /// Constructs a new ThreadPool with the specified number of worker threads.
    pub fn new(num_workers: usize) -> Self {
        assert!(num_workers > 0, "Worker count must be strictly greater than zero");

        let worker_queue = Arc::new(WorkerQueue::new());
        let next_sequence = Arc::new(AtomicU64::new(1));
        let next_task_id = Arc::new(AtomicU64::new(1));
        let total_completed = Arc::new(AtomicU64::new(0));
        let total_panicked = Arc::new(AtomicU64::new(0));

        let (scheduler_tx, scheduler_rx) = channel::<SchedulerCommand>();

        // 1. Spawn Worker Threads
        let mut worker_threads = Vec::with_capacity(num_workers);
        for id in 0..num_workers {
            let queue_clone = Arc::clone(&worker_queue);
            let completed_clone = Arc::clone(&total_completed);
            let panicked_clone = Arc::clone(&total_panicked);

            let handle = thread::Builder::new()
                .name(format!("worker-{}", id))
                .spawn(move || {
                    Self::worker_loop(id, queue_clone, completed_clone, panicked_clone);
                })
                .expect("Failed to spawn worker thread");

            worker_threads.push(handle);
        }

        // 2. Spawn Scheduler Loop
        let worker_queue_for_sched = Arc::clone(&worker_queue);
        let scheduler_thread = thread::Builder::new()
            .name("scheduler-engine".to_string())
            .spawn(move || {
                Self::scheduler_loop(scheduler_rx, worker_queue_for_sched);
            })
            .expect("Failed to spawn scheduler engine thread");

        Self {
            worker_queue,
            scheduler_tx: Mutex::new(Some(scheduler_tx)),
            worker_threads: Mutex::new(worker_threads),
            scheduler_thread: Mutex::new(Some(scheduler_thread)),
            next_sequence,
            next_task_id,
            total_completed,
            total_panicked,
            worker_count: num_workers,
        }
    }

    /// Internal worker thread processing loop.
    fn worker_loop(
        _worker_id: usize,
        queue: Arc<WorkerQueue>,
        completed_counter: Arc<AtomicU64>,
        panicked_counter: Arc<AtomicU64>,
    ) {
        loop {
            let mut guard = WorkerQueue::lock_robust(&queue.state);

            loop {
                if guard.terminated {
                    return;
                }

                if let Some(job) = guard.heap.pop() {
                    guard.active_workers += 1;
                    drop(guard);

                    // Execute task inside panic boundary
                    let result = catch_unwind(AssertUnwindSafe(job.task));
                    if result.is_ok() {
                        completed_counter.fetch_add(1, AtomicOrdering::Relaxed);
                    } else {
                        panicked_counter.fetch_add(1, AtomicOrdering::Relaxed);
                        eprintln!("[THREAD-PANIC] Worker survived closure panic. State preserved.");
                    }

                    // Decrement active workers and check drain conditions
                    let mut reacquired = WorkerQueue::lock_robust(&queue.state);
                    reacquired.active_workers -= 1;
                    if reacquired.draining && reacquired.heap.is_empty() && reacquired.active_workers == 0 {
                        queue.drain_complete_cvar.notify_all();
                    }
                    break;
                }

                if guard.draining && guard.heap.is_empty() {
                    return;
                }

                // Park worker on condition variable
                guard = match queue.has_work_cvar.wait(guard) {
                    Ok(g) => g,
                    Err(poisoned) => poisoned.into_inner(),
                };
            }
        }
    }

    /// Internal timer and priority dispatcher loop.
    fn scheduler_loop(receiver: Receiver<SchedulerCommand>, worker_queue: Arc<WorkerQueue>) {
        let mut delayed_heap: BinaryHeap<ScheduledJob> = BinaryHeap::new();
        let mut is_draining = false;

        loop {
            // Determine sleep duration based on the nearest scheduled deadline
            let timeout = if let Some(nearest) = delayed_heap.peek() {
                let now = Instant::now();
                if nearest.execute_at <= now {
                    Duration::ZERO
                } else {
                    nearest.execute_at - now
                }
            } else if is_draining {
                break;
            } else {
                Duration::from_secs(3600 * 24)
            };

            if timeout.is_zero() {
                let now = Instant::now();
                while let Some(top) = delayed_heap.peek() {
                    if top.execute_at <= now {
                        let mature_job = delayed_heap.pop().unwrap();

                        // Verify cancellation
                        if let Some(ref token) = mature_job.cancellation_token {
                            if token.load(AtomicOrdering::SeqCst) {
                                continue;
                            }
                        }

                        let task = (mature_job.task_generator)();
                        worker_queue.push(ReadyJob {
                            priority: mature_job.priority,
                            sequence: mature_job.sequence,
                            task,
                        });

                        // Re-queue recurring schedules
                        if let Some(period) = mature_job.recurring_period {
                            if mature_job.cancellation_token.as_ref().map_or(true, |t| !t.load(AtomicOrdering::SeqCst)) {
                                delayed_heap.push(ScheduledJob {
                                    execute_at: now + period,
                                    sequence: mature_job.sequence,
                                    priority: mature_job.priority,
                                    recurring_period: Some(period),
                                    cancellation_token: mature_job.cancellation_token,
                                    task_generator: mature_job.task_generator,
                                });
                            }
                        }
                    } else {
                        break;
                    }
                }
                continue;
            }

            match receiver.recv_timeout(timeout) {
                Ok(SchedulerCommand::DispatchImmediate(ready_job)) => {
                    worker_queue.push(ready_job);
                }
                Ok(SchedulerCommand::Schedule(scheduled_job)) => {
                    delayed_heap.push(scheduled_job);
                }
                Ok(SchedulerCommand::InitiateDrain) => {
                    is_draining = true;
                    if delayed_heap.is_empty() {
                        break;
                    }
                }
                Ok(SchedulerCommand::TerminateNow) => {
                    break;
                }
                Err(RecvTimeoutError::Timeout) => {}
                Err(RecvTimeoutError::Disconnected) => {
                    break;
                }
            }
        }
    }

    // ========================================================================
    // PUBLIC EXECUTION & SCHEDULING APIS
    // ========================================================================

    /// Submits a fire-and-forget closure with Normal priority.
    pub fn execute<F>(&self, f: F)
    where
        F: FnOnce() + Send + 'static,
    {
        self.execute_with_priority(Priority::Normal, f);
    }

    /// Submits a fire-and-forget closure with an explicit priority tier.
    pub fn execute_with_priority<F>(&self, priority: Priority, f: F)
    where
        F: FnOnce() + Send + 'static,
    {
        let seq = self.next_sequence.fetch_add(1, AtomicOrdering::Relaxed);
        let ready_job = ReadyJob {
            priority,
            sequence: seq,
            task: Box::new(f),
        };

        self.send_command(SchedulerCommand::DispatchImmediate(ready_job));
    }

    /// Submits a value-returning closure, providing a `JobHandle` to join its outcome.
    pub fn submit<F, R>(&self, f: F) -> JobHandle<R>
    where
        F: FnOnce() -> R + Send + 'static,
        R: Send + 'static,
    {
        self.submit_with_priority(Priority::Normal, f)
    }

    /// Submits a value-returning closure with an explicit priority tier.
    pub fn submit_with_priority<F, R>(&self, priority: Priority, f: F) -> JobHandle<R>
    where
        F: FnOnce() -> R + Send + 'static,
        R: Send + 'static,
    {
        let (handle, completer) = JobHandle::new();
        let seq = self.next_sequence.fetch_add(1, AtomicOrdering::Relaxed);

        let task = Box::new(move || {
            let res = catch_unwind(AssertUnwindSafe(f));
            match res {
                Ok(val) => completer.complete(Ok(val)),
                Err(payload) => {
                    let msg = extract_panic_payload(payload);
                    completer.complete(Err(JobError::Panicked(msg)));
                }
            }
        });

        let ready_job = ReadyJob {
            priority,
            sequence: seq,
            task,
        };

        self.send_command(SchedulerCommand::DispatchImmediate(ready_job));
        handle
    }

    /// Schedules a task for execution after a specific relative delay.
    pub fn schedule_after<F, R>(&self, delay: Duration, priority: Priority, f: F) -> JobHandle<R>
    where
        F: FnOnce() -> R + Send + 'static,
        R: Send + 'static,
    {
        self.schedule_at(Instant::now() + delay, priority, f)
    }

    /// Schedules a task for execution at a specific absolute instant.
    pub fn schedule_at<F, R>(&self, execute_at: Instant, priority: Priority, f: F) -> JobHandle<R>
    where
        F: FnOnce() -> R + Send + 'static,
        R: Send + 'static,
    {
        let (handle, completer) = JobHandle::new();
        let seq = self.next_sequence.fetch_add(1, AtomicOrdering::Relaxed);

        let cell = Arc::new(Mutex::new(Some((f, completer))));
        let task_generator = Box::new(move || {
            let cell_clone = Arc::clone(&cell);
            let closure: TaskClosure = Box::new(move || {
                let mut guard = cell_clone.lock().unwrap();
                if let Some((func, comp)) = guard.take() {
                    let res = catch_unwind(AssertUnwindSafe(func));
                    match res {
                        Ok(val) => comp.complete(Ok(val)),
                        Err(payload) => {
                            let msg = extract_panic_payload(payload);
                            comp.complete(Err(JobError::Panicked(msg)));
                        }
                    }
                }
            });
            closure
        });

        let scheduled_job = ScheduledJob {
            execute_at,
            sequence: seq,
            priority,
            recurring_period: None,
            cancellation_token: None,
            task_generator,
        };

        self.send_command(SchedulerCommand::Schedule(scheduled_job));
        handle
    }

    /// Schedules a recurring closure running periodically at a fixed duration interval.
    pub fn schedule_repeating<F>(
        &self,
        initial_delay: Duration,
        interval: Duration,
        priority: Priority,
        f: F,
    ) -> RecurringHandle
    where
        F: Fn() + Send + Sync + 'static,
    {
        let task_id = self.next_task_id.fetch_add(1, AtomicOrdering::Relaxed);
        let seq = self.next_sequence.fetch_add(1, AtomicOrdering::Relaxed);
        let cancelled = Arc::new(AtomicBool::new(false));

        let recurring_handle = RecurringHandle {
            task_id,
            cancelled: Arc::clone(&cancelled),
        };

        let f = Arc::new(f);
        let task_generator = Box::new(move || {
            let f_clone = Arc::clone(&f);
            let closure: TaskClosure = Box::new(move || {
                let _ = catch_unwind(AssertUnwindSafe(|| {
                    f_clone();
                }));
            });
            closure
        });

        let scheduled_job = ScheduledJob {
            execute_at: Instant::now() + initial_delay,
            sequence: seq,
            priority,
            recurring_period: Some(interval),
            cancellation_token: Some(cancelled),
            task_generator,
        };

        self.send_command(SchedulerCommand::Schedule(scheduled_job));
        recurring_handle
    }

    fn send_command(&self, cmd: SchedulerCommand) {
        let guard = self.scheduler_tx.lock().unwrap();
        if let Some(ref tx) = *guard {
            let _ = tx.send(cmd);
        }
    }

    // ========================================================================
    // SHUTDOWN & TELEMETRY
    // ========================================================================

    /// Initiates a graceful shutdown, draining all queued and in-flight operations.
    pub fn shutdown(self) {
        // Disconnect scheduler intake
        {
            let mut guard = self.scheduler_tx.lock().unwrap();
            if let Some(tx) = guard.take() {
                let _ = tx.send(SchedulerCommand::InitiateDrain);
            }
        }

        // Await scheduler exit
        if let Some(handle) = self.scheduler_thread.lock().unwrap().take() {
            let _ = handle.join();
        }

        // Flag worker queue as draining
        {
            let mut guard = WorkerQueue::lock_robust(&self.worker_queue.state);
            guard.draining = true;
            self.worker_queue.has_work_cvar.notify_all();

            // Wait for queue exhaustion and active workers to reach zero
            while !guard.heap.is_empty() || guard.active_workers > 0 {
                guard = match self.worker_queue.drain_complete_cvar.wait(guard) {
                    Ok(g) => g,
                    Err(p) => p.into_inner(),
                };
            }
            guard.terminated = true;
            self.worker_queue.has_work_cvar.notify_all();
        }

        // Join all worker threads cleanly
        let mut threads = self.worker_threads.lock().unwrap();
        for handle in threads.drain(..) {
            let _ = handle.join();
        }
    }

    pub fn worker_count(&self) -> usize {
        self.worker_count
    }

    pub fn completed_count(&self) -> u64 {
        self.total_completed.load(AtomicOrdering::Relaxed)
    }

    pub fn panic_count(&self) -> u64 {
        self.total_panicked.load(AtomicOrdering::Relaxed)
    }

    pub fn active_count(&self) -> usize {
        let guard = WorkerQueue::lock_robust(&self.worker_queue.state);
        guard.active_workers
    }

    pub fn queued_count(&self) -> usize {
        let guard = WorkerQueue::lock_robust(&self.worker_queue.state);
        guard.heap.len()
    }
}

impl Drop for ThreadPool {
    fn drop(&mut self) {
        let mut tx_guard = self.scheduler_tx.lock().unwrap();
        if let Some(tx) = tx_guard.take() {
            let _ = tx.send(SchedulerCommand::InitiateDrain);
        }
        drop(tx_guard);

        if let Some(handle) = self.scheduler_thread.lock().unwrap().take() {
            let _ = handle.join();
        }

        {
            let mut guard = WorkerQueue::lock_robust(&self.worker_queue.state);
            guard.draining = true;
            guard.terminated = true;
            self.worker_queue.has_work_cvar.notify_all();
        }

        let mut threads = self.worker_threads.lock().unwrap();
        for handle in threads.drain(..) {
            let _ = handle.join();
        }
    }
}

fn extract_panic_payload(payload: Box<dyn Any + Send>) -> String {
    if let Some(s) = payload.downcast_ref::<&str>() {
        s.to_string()
    } else if let Some(s) = payload.downcast_ref::<String>() {
        s.clone()
    } else {
        "Box<dyn Any> unknown panic object".to_string()
    }
}

